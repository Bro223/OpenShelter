@startuml
title Shelter Map - Shelter API (read + write + community reviews)
' Thin controllers (Ch 1: service providers for HTTP) - parse, validate, delegate, map. No business logic.
' DTO records are the versioned contract with the frontend (Vue/Angular).
' Depends only on interfaces from other contexts (01): ShelterRepository, ShelterReviewRepository, ShelterService.

package "api" {
  class ShelterController {
    + GET    /api/shelters?source=REGISTRY|USER|ALL
    + GET    /api/shelters/{id}
    + POST   /api/shelters
    + GET    /api/shelters/mine
    + PUT    /api/shelters/{id}
    + DELETE /api/shelters/{id}
  }

  class ReviewController {
    + GET    /api/shelters/{id}/reviews
    + POST   /api/shelters/{id}/reviews
    + PUT    /api/shelters/{id}/reviews/mine
    + DELETE /api/shelters/{id}/reviews/mine
  }

  class AccountController {
    ' /account group (M1) - the one shelter-related endpoint added in M8
    + GET /account/reviews/mine
  }

  class LocationController {
    ' shelter-location-input (8686b99) - thin shell for the short-link
    ' resolver: parse, validate, delegate, map (Ch 1). JWT-protected
    ' (inside the authenticated set, NOT permitAll) + per-IP 5/min
    ' token bucket (geoResolveRateLimiter, keys via ClientIps - auth/03).
    + POST /api/geo/resolve (body : LocationResolveRequest) : LocationResolvedDto
  }

  class LocationResolveRequest <<record>> {
    + url : String   ' @NotBlank @Size(max = 2048)
  }

  class LocationResolvedDto <<record>> {
    + latitude : double
    + longitude : double
    ' Field names are the frontend contract (LocationResolved) - do not rename.
  }

  class ShelterQueryService {
    + findAll(filter : ShelterSourceFilter) : List<ShelterDto>
    + findById(id : Long) : Optional<ShelterDto>
    + findByCreatedBy(userId : Long) : List<ShelterDto>
    ' M8 author-scoped list - same lean DTO projection (no N+1).
  }

  class ShelterReviewService {
    + addReview(user : RegisteredUser, shelterId : Long, rating : int, comment : String) : SaveResult
    + updateReview(user : RegisteredUser, shelterId : Long, rating : int, comment : String) : ShelterReview
    + deleteReview(user : RegisteredUser, shelterId : Long) : void
    + getReviews(shelterId : Long) : List<ShelterReviewDto>
    ' SaveResult = (review, created) - the upsert outcome the controller
    ' maps to 201 (created) / 200 (updated).
    ' getRatingSummary was removed in the review-fix pass (dead code -
    ' no HTTP endpoint consumed it; rating aggregates are served via
    ' ShelterDto / the batched findRatingAggregates query).
  }

  class ShelterDto <<record>> {
    + id : Long
    + name : String
    + address : String
    + latitude : double
    + longitude : double
    + status : ShelterStatus
    + source : ShelterSource
    + averageRating : Double
    + reviewCount : int
    + createdAt : Instant
    + description : String
    + capacity : Integer
    ' Lean projection: the full registry record (county, municipality,
    ' data-as-of, attribution) is stored in the DB but not dumped here -
    ' the UI gets only what the map needs.
    ' description/capacity: USER-submission details (stored since V3;
    ' null for registry rows).
  }

  class CreateShelterRequest <<record>> {
    + name : String
    + latitude : double
    + longitude : double
    + description : String
    + capacity : Integer
  }

  class UpdateShelterRequest <<record>> {
    ' M8: constraints IDENTICAL to CreateShelterRequest (create/update cannot drift);
    ' only these five fields are writable on an existing shelter
    + name : String
    + latitude : double
    + longitude : double
    + description : String
    + capacity : Integer
  }

  class ReviewRequest <<record>> {
    + rating : int
    + comment : String
  }

  class ShelterReviewDto <<record>> {
    + id : Long
    + authorName : String
    + rating : int
    + comment : String
    + createdAt : Instant
  }

  class MyReviewDto <<record>> {
    ' M8: one row of GET /account/reviews/mine (the caller's review of a
    ' shelter, carrying the shelter's id + name for navigation)
    + shelterId : long
    + shelterName : String
    + rating : int
    + comment : String
    + createdAt : Instant
    + updatedAt : Instant
  }

  class ErrorResponse <<record>> {
    + timestamp : Instant
    + status : int
    + error : String
    + message : String
    + path : String
  }

  enum ShelterSourceFilter {
    REGISTRY
    USER
    ALL
  }
}

' ============ LOCATION RESOLUTION (shelter-location-input, 8686b99) ============
' app/ classes shown as contracts - defined in 01 (app context).
package "app - location resolution (contracts only)" {
  class LocationResolveService {
    + {static} WHITELISTED_HOST = "maps.app.goo.gl"
    + resolve(url : String) : Outcome   ' Resolved / NotFound / UpstreamFailure
  }

  note bottom of LocationResolveService
    Deliberately narrow (shelter-location-input): host whitelist
    (maps.app.goo.gl is the only host the client sends) + a manual
    <=3-hop redirect walk (every hop re-validated - auto-follow stays
    OFF) under a 10 s budget (3 s connect / 5 s read per hop).
    One generic 400 for every not-found variant (invalid input /
    non-whitelisted host / no extractable pair / outside Estonia -
    no enumeration); one generic 502 for every upstream failure
    (timeout / network / upstream 5xx - no upstream detail).
  end note

  interface RedirectClient {
    + fetch(url : String) : RedirectHop   ' one hop, status + Location header
    ' The seam that keeps LocationResolveService unit-testable.
  }

  class HttpUrlRedirectClient {
  }

  note bottom of HttpUrlRedirectClient
    Real hop fetcher: 3 s connect / 5 s read per hop, redirects NOT
    auto-followed, no cookies, fixed User-Agent; the status line +
    Location header only - never the body.
  end note

  class MapsUrlCoordinates {
    + {static} extract(url : String) : GeoPoint
  }

  note bottom of MapsUrlCoordinates
    The shared long-form map-URL pattern list, with the Estonia-bbox
    gate + (lng,lat) auto-swap - the same rules the frontend parser
    uses; both sides tested against the same fixture table.
  end note
}

' ============ CONTRACT WITH OTHER CONTEXTS (interfaces only) ============
ShelterController --> ShelterQueryService : GET + GET /mine
ShelterController --> ShelterService : POST / PUT / DELETE (app/01)
ShelterController --> CreateShelterRequest : parses body
ShelterController --> UpdateShelterRequest : parses PUT body
AccountController --> ShelterReviewRepository : findByUserId (interface, 01)
AccountController --> ShelterRepository : findByIds (batched names, 01)
AccountController --> MyReviewDto : returns
ShelterController --> ErrorResponse : 400/401/403/404/429
ShelterQueryService --> ShelterRepository : reads (interface, 01)
ShelterQueryService --> Shelter : maps to DTO
ShelterQueryService --> ShelterDto : returns

ReviewController --> ShelterReviewService
ShelterReviewService --> ShelterReviewRepository : interface (01)
ShelterReviewService --> RegisteredUser : requires verified account
ShelterReviewService ..> ShelterReview : upserts
ShelterReviewService --> ShelterReviewDto
ReviewController --> ReviewRequest
ShelterReviewService ..> ErrorResponse : 403 if not verified / not author

' ---- location resolution (POST /api/geo/resolve) ----
LocationController --> LocationResolveService : resolve(url)
LocationController --> LocationResolveRequest : parses body
LocationController --> LocationResolvedDto : returns
LocationController ..> RateLimiter : per-IP 5/min bucket (geoResolveRateLimiter, auth/03)
LocationController ..> ErrorResponse : 400 / 429 / 502
LocationResolveService ..> RedirectClient : hop walk (seam)
HttpUrlRedirectClient ..|> RedirectClient : real hop fetcher
LocationResolveService --> MapsUrlCoordinates : pair extraction on the final URL

ShelterSourceFilter ..> ShelterRepository : ?source= maps to findAllBySourceIn()
ShelterSourceFilter --> ShelterSource : REGISTRY={PAASETEAMET,MUNICIPALITY}, USER={USER}, ALL={all}

note bottom of ShelterController
  GET  /api/shelters?source=REGISTRY|USER|ALL  (public - VIEW_MAP baseline)
  GET  /api/shelters/{id}                      (public)
  POST /api/shelters                           (Bearer JWT, canWrite() check)
  GET  /api/shelters/mine                      (Bearer JWT - the CALLER's shelters, NOT public)
  PUT    /api/shelters/{id}                    (Bearer JWT, author-only USER rows)
  DELETE /api/shelters/{id}                    (Bearer JWT, author-only; reviews cascade)
  POST /api/geo/resolve                        (Bearer JWT, per-IP 5/min -> 429;
       LocationController - 400 ONE generic message when no pair / outside
       Estonia / non-whitelisted host; 502 ONE generic retry-later message on
       upstream failure - no enumeration, no upstream detail)
  Author check (PUT/DELETE): 404 if absent, 403 if not the author - registry rows and
  legacy created_by-NULL rows are unmanageable by anyone (ids are public, so
  403-vs-404 leaks nothing). PUT re-checks the Estonia bbox - one shared gate with
  POST, so create/update cannot drift.
  Deferred: nearest/bbox queries need GeoService + PostGIS GIST index.
  Paging deferred: Estonia-scale data is small; add limit/offset when it grows.
end note

note right of ShelterQueryService
  shelters.created_by (V7): BIGINT NULL REFERENCES users(id) ON DELETE SET NULL +
  idx_shelters_created_by. addPlace sets it (the submitting user); NULL for registry
  rows and pre-V7 legacy USER rows. GET /mine queries it; PUT/DELETE gate on it.
end note

note bottom of ShelterReviewService
  Community rating IS the moderation - no moderator role.
  - One review per user per shelter (unique shelterId+userId); re-rating updates
  - Requires an authenticated, VERIFIED account (any VerificationClaim)
  - update/delete: author only (ownership check)
  - rating 1..5, comment <= 500 chars
  - Aggregates computed per request in v1; denormalize onto Shelter or
    Redis-cache when traffic grows (SDI Ch 6)
end note
@enduml

@startuml
title Shelter Map - API Flows (sequence)
actor Client

participant "ShelterController" as SC
participant "ShelterQueryService" as SQS
participant "ShelterRepository" as REPO
participant "ShelterService" as SS
participant "ShelterReviewService" as RVS
participant "ShelterReviewRepository" as RREPO
participant "AccountController" as ACC
participant "LocationController" as LC
participant "LocationResolveService" as LRS
participant "HttpUrlRedirectClient" as HRC
database "PostgreSQL" as DB

== 1. GET /api/shelters?source=USER (public) ==
Client -> SC : GET /api/shelters?source=USER
SC -> SQS : findAll(USER)
SQS -> REPO : findAllBySourceIn([USER])
REPO -> DB : SELECT ... WHERE source IN (...)
REPO --> SQS : List<Shelter>
SQS --> SC : List<ShelterDto> (with averageRating, reviewCount)
SC --> Client : 200 [ShelterDto]

== 2. POST /api/shelters (Bearer JWT, verified user) ==
Client -> SC : POST /api/shelters {name, lat, lng, ...}
SC -> SS : addPlace(user, shelter)
SS -> DB : save shelter (status = ACTIVE, source = USER, created_by = user)
SS --> SC : Shelter
SC --> Client : 201 + Location

== 3. POST /api/shelters/{id}/reviews (Bearer JWT, verified user) ==
Client -> RVS : POST review {rating, comment}
RVS -> RREPO : findByShelterIdAndUserId(shelterId, userId)
alt existing review
  RVS -> RREPO : save(updated)  (re-rating = update)
else new review
  RVS -> RREPO : save(created)
end
RVS --> Client : 200/201

== 4. GET /api/shelters/{id}/reviews (public) ==
Client -> RVS : GET reviews
RVS -> RREPO : findByShelterId(shelterId)
RREPO --> RVS : List<ShelterReview>
RVS --> Client : 200 [ShelterReviewDto]

== 5. GET /api/shelters/mine (Bearer JWT) ==
Client -> SC : GET /api/shelters/mine
SC -> SQS : findByCreatedBy(me)
SQS -> REPO : findByCreatedBy(userId)
REPO -> DB : SELECT ... WHERE created_by = ?
REPO --> SQS : List<Shelter>
SQS --> SC : List<ShelterDto> (never other users' or registry rows)
SC --> Client : 200 [ShelterDto]

== 6. PUT /api/shelters/{id} (Bearer JWT, author-only) ==
Client -> SC : PUT {name, lat, lng, description, capacity}
SC -> REPO : findById(id)
alt absent
  SC --> Client : 404 (uniform ErrorResponse)
else not the author (or a registry / legacy created_by-NULL row)
  SC --> Client : 403
else author
  note right of SC: bbox re-check (shared gate with POST) -> 400 outside Estonia
  SC -> SS : updatePlace(updated)  ' the five fields only
  SS -> DB : UPDATE (status/source/createdBy/created_at untouched)
  SC --> Client : 200 ShelterDto
end

== 7. DELETE /api/shelters/{id} (Bearer JWT, author-only) ==
Client -> SC : DELETE
SC -> REPO : findById(id) + author check (404 / 403 as above)
SC -> DB : DELETE shelter (ON DELETE CASCADE -> shelter_reviews)
SC --> Client : 204 No Content

== 8. GET /account/reviews/mine (Bearer JWT) ==
Client -> ACC : GET /account/reviews/mine
ACC -> DB : reviews WHERE user_id = ? (one query)
ACC -> DB : shelters WHERE id IN (...) (batched shelter names - no N+1)
ACC --> Client : 200 [MyReviewDto]

== 9. POST /api/geo/resolve (Bearer JWT, per-IP 5/min) ==
Client -> LC : POST /api/geo/resolve {url}
alt per-IP bucket empty (5/min)
  LC --> Client : 429 (uniform ErrorResponse)
else
  LC -> LRS : resolve(url)   ' host whitelist: maps.app.goo.gl only
  LRS -> HRC : fetch(url)  (one hop, NO auto-follow; 3 s connect / 5 s read, 10 s budget)
  alt 3xx with Location (re-validated hop, <= 3 total)
    HRC --> LRS : RedirectHop(3xx, Location) - walk continues
  else terminal response
    HRC --> LRS : RedirectHop(status, Location?)
  end
  alt pair extracted on the final URL (bbox gate + auto-swap)
    LRS --> LC : Outcome.Resolved(latitude, longitude)
    LC --> Client : 200 {latitude, longitude}
  else invalid input / other host / no pair / outside Estonia
    LRS --> LC : Outcome.NotFound
    LC --> Client : 400 ONE generic message (no enumeration)
  else timeout / network failure / upstream 5xx
    LRS --> LC : Outcome.UpstreamFailure
    LC --> Client : 502 ONE generic retry-later message (no upstream detail)
  end
end
@enduml
