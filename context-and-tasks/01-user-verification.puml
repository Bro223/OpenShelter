@startuml
title Shelter Map - User & Verification (Core with providers)

' ============================================================
' CLASS-CREATION RULES (Thinking in Java, Ch 1 & 2)
' 1. Every object is a service provider (Ch 1): ask "who is the
'    best object to service this request?" -> entities answer
'    about themselves; services perform work.
' 2. Inheritance only for genuine is-a, fixed at creation (Ch 1):
'    User (abstract = Bird) <- GuestUser (Pigeon), RegisteredUser
'    (Penguin), AdminUser (admin-moderation D1 - the env-provisioned admin;
'    it was removed as dead code in the review-fix pass and came back WITH a
'    real provisioning path, the auth AdminSeeder - never the registration
'    flow). Subclasses OVERRIDE base methods; they never add
'    methods a base reference cannot see.
' 3. Prefer composition first (Ch 1): runtime-changing state is
'    DATA. Verification = Set<VerificationClaim> - an object never
'    changes class, but its claims can be added/revoked.
' 4. Program to an interface (Ch 9): providers/channels/repos are
'    interfaces; implementations are swappable (Twilio vs Dev).
' 5. Hidden implementation (Ch 1): fields private, methods public.
' 6. A class is a new data type (Ch 2): fields + methods bundled.
' ============================================================

package "domain" {
  abstract class User {
    - id : Long
    --
    + getData() : UserData
    + canWrite() : boolean
    + deleteAccount() : void
  }

  class GuestUser {
    --
    + canWrite() : boolean
    + deleteAccount() : void
  }

  class RegisteredUser {
    - name : String
    - email : String
    - phone : String
    - verifications : Set<VerificationClaim>
    --
    + RegisteredUser(name, email, phone)
    + levels() : Set<VerificationLevel>
    + canWrite() : boolean
    + deleteAccount() : void
  }

  class AdminUser {
    ' The third fixed kind (admin-moderation D1): the env-provisioned
    ' admin - a fully verified registered account whose row kind, not its
    ' class, is the authorization truth (fresh kind lookup per /admin/*
    ' request, no JWT claim - D2).
    --
    + AdminUser(name, email, phone)
    ' persistence ctor: the stored claims are restored by UserMapper
    ' (NOT pre-set - a reload reflects the stored claim state); phone
    ' is null for provisioned admins (no phone route)
    + {static} provisioned(name, email, now : Instant) : AdminUser
    ' AdminSeeder factory ONLY: phone = null (no ID code stored - M1), EVERY
    ' verification claim pre-set (EMAIL/PHONE/SMART_ID) - the mailbox does
    ' not exist by design, so canWrite() is true from the first request
  }

  class UserData <<record>> {
    + name : String
    + email : String
    + phone : String
    + levels : Set<VerificationLevel>
  }

  enum VerificationLevel {
    EMAIL
    PHONE
    SMART_ID
  }

  class VerificationClaim {
    - id : Long
    - level : VerificationLevel
    - provider : String
    - externalRef : String
    - verifiedAt : Instant
    - revokedAt : Instant
  }

  class VerificationPolicy {
    - rules : VerificationRules
    --
    + VerificationPolicy(rules : VerificationRules)
    + allows(levels : Set<VerificationLevel>, capability : Capability) : boolean
  }

  class VerificationRules <<record>> {
    + baseline : Set<Capability>
    + byLevel : Map<VerificationLevel, Set<Capability>>
    + ofDefaults() : VerificationRules
  }

  enum Capability {
    VIEW_MAP
    SUBMIT_SHELTER
  }

  class Shelter {
    - id : Long
    - name : String
    - location : GeoPoint
    - status : ShelterStatus
    - externalId : String
    - source : ShelterSource
    - address : String
    - county : String
    - municipality : String
    - dataAsOf : String
    - sourceAttribution : String
    - description : String
    - capacity : Integer
    ' Full registry record stored locally (see 04-ingestion.puml);
    ' the API serves a lean projection (05-shelter-api.puml).
    ' description/capacity are USER-submission details (V3 hardening:
    ' previously validated at the boundary then silently dropped).
  }
  enum ShelterStatus {
    ACTIVE
    INACTIVE
    ' PENDING/REJECTED removed in the review-fix pass (no moderator in v1)
  }

  enum ShelterSource {
    PAASETEAMET
    MUNICIPALITY
    USER
  }

  class GeoPoint <<record>> {
    + lat : double
    + lng : double
  }

}

package "verification" {
  interface VerificationProvider {
    + providerCode() : String
    + level() : VerificationLevel
    + request(user : RegisteredUser) : PendingVerification
    + confirm(user : RegisteredUser, pending : PendingVerification, code : String) : boolean
  }

  class EmailVerificationProvider {
    - sender : SmtpSender
    --
    + request(user : RegisteredUser) : PendingVerification
    + confirm(user : RegisteredUser, pending : PendingVerification, code : String) : boolean
  }

  class PhoneVerificationProvider {
    - sender : SmsSender
    --
    + request(user : RegisteredUser) : PendingVerification
    + confirm(user : RegisteredUser, pending : PendingVerification, code : String) : boolean
    ' providerCode() = "sms" (channel-agnostic — Twilio is swappable).
    ' E.164-normalizes the phone at the channel boundary (PhoneNumbers).
  }

  class SmartIdVerificationProvider {
    --
    + request(user : RegisteredUser) : PendingVerification
    + confirm(user : RegisteredUser, pending : PendingVerification, code : String) : boolean
    ' STUB in v1 — both methods throw UnsupportedOperationException.
  }

  interface SmsSender {
    + send(phone : String, message : String) : void
  }

  class TwilioSmsSender {
    - api : TwilioApi
    - messagingServiceSid : String
    - fromNumber : String
    --
    + send(phone : String, message : String) : void
    ' Production channel: Twilio Programmable Messaging, send-only.
    ' Selected via app.sms.provider=twilio; credentials from env vars
    ' (TWILIO_ACCOUNT_SID/AUTH_TOKEN + MESSAGING_SERVICE_SID or TWILIO_FROM).
    ' Logs metadata only, never the OTP body. Delivery errors are logged,
    ' never thrown (anti-enumeration).
    ' TwilioApi seam (SDK impl + hand-written fake in tests — no Mockito).
  }

  class DevSmsSender {
    + send(phone : String, message : String) : void
    ' Dev/CI: logs the message to the console (no real SMS).
    ' Default bean via app.sms.provider=dev (matchIfMissing).
  }

  class PhoneNumbers {
    + normalizeE164(phone : String) : String
    ' Lenient E.164 normalization (Estonian default +372, strips separators).
  }

  interface VerificationSendLog {
    + countToday(userId : Long, level : VerificationLevel) : long
    + lastSentAt(userId : Long, level : VerificationLevel) : Instant
    + record(userId : Long, level : VerificationLevel, contact : String, sentAt : Instant) : void
  }

  class FileVerificationSendLog {
    - path : Path
    --
    + FileVerificationSendLog(path : Path, clock : Clock)
    ' Durable store behind the anti-spam daily cap — survives restarts.
    ' One line per send: userId<TAB>level<TAB>contact<TAB>epochMillis.
    ' Never throws on IO failures; prunes entries older than 2 days.
  }

  interface SmtpSender {
    + send(email : String, message : String) : void
  }

  class DevSmtpSender {
    + send(email : String, message : String) : void
    ' Dev/CI: logs the message to the console (no real SMTP).
    ' Default bean via app.mail.provider=dev (matchIfMissing) - exactly one
    ' SmtpSender exists at runtime (dev | smtp-pulse).
  }

  class SmtpPulseSmtpSender {
    + send(email : String, message : String) : void
    ' Production channel: spring-boot-starter-mail + smtp-pulse.com, selected
    ' via app.mail.provider=smtp-pulse. Logs metadata only, never the body.
    ' Credentials via env vars only (spring.mail.username/password).
  }

  class VerificationService {
    - providers : Map<VerificationLevel, VerificationProvider>
    - sendLog : VerificationSendLog
    - properties : VerificationProperties
    - clock : Clock
    --
    + VerificationService(providers : Map<VerificationLevel, VerificationProvider>, pendingRepository : PendingVerificationRepository, sendLog : VerificationSendLog, properties : VerificationProperties, clock : Clock)
    + requestVerification(user : RegisteredUser, level : VerificationLevel) : void
    + confirmVerification(user : RegisteredUser, level : VerificationLevel, code : String) : boolean
    ' Anti-spam: resend cooldown + per-user daily cap (VerificationSendLog)
    ' -> VerificationThrottledException -> 429. (No revoke method — claim
    ' revocation is pure domain state: RegisteredUser.revoke.)
  }

  class PendingVerification {
    - id : Long
    - level : VerificationLevel
    - contact : String
    - codeHash : String
    - attempts : int
    - expiresAt : Instant
  }
}

package "app" {
  class UserService {
    + register(name : String, email : String, phone : String) : RegisteredUser
    + findByEmailOrPhone(contact : String) : RegisteredUser
    + findByEmail(email : String) : RegisteredUser
    + findByPhone(phone : String) : RegisteredUser
  }
  interface UserRepository {
    + save(user : User) : void
    + findById(id : Long) : User
    + findByEmail(email : String) : RegisteredUser
    ' REGISTERED and ADMIN rows (kind restored by the mapper) - the admin
    ' logs in through the normal /auth/login and the registration pre-check
    ' sees the admin's email as in use (409); case-insensitive
    + findByPhone(phone : String) : RegisteredUser
    + isAdmin(id : Long) : boolean
    ' admin-moderation D2: the fresh kind lookup behind every /admin/*
    ' request (also the 10-shelter cap exemption) - one indexed PK lookup
    + findByIds(ids : Collection<Long>) : Map<Long, User>
  }

  class ShelterService {
    + addPlace(user : User, place : Shelter) : void
  }
interface ShelterRepository {
    + save(shelter : Shelter) : void
    + findByExternalId(externalId : String) : Optional<Shelter>
    + findById(id : Long) : Optional<Shelter>
    + deleteBySourceAndExternalIdNotIn(source : ShelterSource, externalIds : List<String>) : int
    + findAll() : List<Shelter>
    + findAllActiveBySourceIn(sources : List<ShelterSource>) : List<Shelter>
    + countByCreatedByAndSourceAndStatus(createdBy : Long, source : ShelterSource, status : ShelterStatus) : long
    + countByCreatedByAndSourceAndCreatedAtAfter(createdBy : Long, source : ShelterSource, createdAtAfter : Instant) : long
    + countByCreatedByAndSourceAndReviewStatus(createdBy : Long, source : ShelterSource, reviewStatus : ReviewStatus) : long
    + findFirstByCreatedByAndSourceAndCreatedAtAfterOrderByCreatedAtAsc(createdBy : Long, source : ShelterSource, createdAtAfter : Instant) : Optional<Shelter>
    + findByCreatedBy(userId : Long) : List<Shelter>
    + findByIds(ids : Collection<Long>) : List<Shelter>
    + deleteById(id : Long) : void
  }
}

' ==================== THE BIRD RULE ====================
GuestUser --|> User
RegisteredUser --|> User
AdminUser --|> RegisteredUser
' kind is fixed at creation and must survive every save (UserMapper checks
' AdminUser BEFORE RegisteredUser - it IS-A RegisteredUser)

' ==================== COMPOSITION / DATA ====================
RegisteredUser "1" *-- "many" VerificationClaim : holds
VerificationClaim --> VerificationLevel
User --> UserData : getData() returns snapshot
RegisteredUser ..> Shelter : addPlace() creates
VerificationPolicy --> VerificationRules : reads rules
VerificationRules --> Capability
VerificationRules --> VerificationLevel

' ==================== PROVIDERS (Ch 9) ====================
EmailVerificationProvider ..|> VerificationProvider
PhoneVerificationProvider ..|> VerificationProvider
SmartIdVerificationProvider ..|> VerificationProvider
TwilioSmsSender ..|> SmsSender
DevSmsSender ..|> SmsSender
TwilioSmsSender --> PhoneNumbers : normalizes to E.164
PhoneVerificationProvider --> SmsSender : sends OTP
PhoneVerificationProvider --> PhoneNumbers : E.164 at the channel boundary
EmailVerificationProvider --> SmtpSender : sends token
DevSmtpSender ..|> SmtpSender
SmtpPulseSmtpSender ..|> SmtpSender

' ==================== ANTI-SPAM SEND LOG ====================
FileVerificationSendLog ..|> VerificationSendLog
VerificationService --> VerificationSendLog : cooldown + daily cap
VerificationSendLog --> VerificationLevel

' ==================== SERVICES = COLLABORATORS ====================
UserService ..> User : operates on
UserService ..> UserRepository
UserRepository ..> User : persists

VerificationService --> VerificationProvider : dispatches by level
VerificationService --> PendingVerification : creates / validates
VerificationService --> VerificationClaim : creates / revokes
RegisteredUser ..> VerificationPolicy : canWrite() delegates
ShelterService ..> User : checks canWrite() first
ShelterService ..> Shelter : creates ACTIVE shelter (no moderation)
ShelterService ..> ShelterRepository
ShelterRepository ..> Shelter : persists

note bottom of Shelter
  User submissions are created ACTIVE immediately - nothing to approve,
  there is no moderator. Quality is governed by community reports +
  confirmation (ReviewStatus on the shelter) instead. (ShelterStatus.
  PENDING/REJECTED were removed in the review-fix pass.)
end note

note bottom of User
  ABSTRACT main class - common to ALL users (every kind IS-A User).
  Subclasses are kinds of user, fixed at creation:
    GuestUser       = anonymous viewer (never persisted)
    RegisteredUser  = account holder, becomes verified over time
  Verification is NOT a subclass: a user can become verified AFTER
  creation, and objects never change class (TIJ Ch 1/7). So
  verification = claims (data), like the wing colour of a pigeon.
end note

note bottom of VerificationPolicy
  Rules as data (config, not code) - change without rebuilding:
    VIEW_MAP          -> baseline (no claims needed; guests can watch)
    SUBMIT_SHELTER    -> EMAIL or PHONE or SMART_ID
  Answer = baseline + union of byLevel[level] for each active level.
end note
@enduml