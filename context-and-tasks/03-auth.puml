@startuml
title Shelter Map - Authentication & Password Reset (auth context)

' ============================================================
' AUTH BOUNDED CONTEXT - developed independently (parallel work)
' Depends only on CONTRACTS from other contexts:
'   - UserService (app context, 01)  -> profile lookup
'   - RegisteredUser (domain, 01)    -> identity
'   - SmtpSender (verification, 01)  -> reset email channel
' Three concerns kept separate (no blob service):
'   VERIFICATION (01)  = prove you own a contact -> claims
'   AUTHENTICATION     = prove you are the same person -> password
'   PASSWORD RESET     = recover auth via the VERIFIED email
' ============================================================

package "auth" {
  class UserCredentials {
    - userId : Long
    - passwordHash : String
    - createdAt : Instant
    - changedAt : Instant
    --
    + UserCredentials(userId : Long, passwordHash : String, now : Instant)
  }

  class PasswordResetToken {
    - id : Long
    - userId : Long
    - tokenHash : String
    - expiresAt : Instant
    - usedAt : Instant
    - attempts : int
    - createdAt : Instant   ' V8 rotation anchor: the 60 s re-issue cooldown
                            ' + the per-UTC-day cap read from this column
  }

  interface PasswordHasher {
    + hash(plain : String) : String
    + verify(plain : String, hash : String) : boolean
  }

  class Argon2PasswordHasher {
    + hash(plain : String) : String
    + verify(plain : String, hash : String) : boolean
  }

  interface TokenService {
    + issue(user : RegisteredUser) : TokenResponse
    + refresh(refreshToken : String) : TokenResponse
    + revoke(refreshToken : String) : void
    + validateAccessToken(accessToken : String) : Long
    ' The JwtAuthenticationFilter's per-request validation seam - returns
    ' the user id the token was issued to (sub claim); any failure is
    ' InvalidAccessTokenException (the filter answers nothing on it).
  }

  class JwtTokenService {
    + issue(user : RegisteredUser) : TokenResponse
    + refresh(refreshToken : String) : TokenResponse
    + revoke(refreshToken : String) : void
    + validateAccessToken(accessToken : String) : Long
    ' refresh() additionally: refuses a SUSPENDED account (the freshly
    ' loaded user, never a token claim) and stamps sign-in activity
    ' (retention-pruning) on the fresh row.
  }

  interface RefreshTokenRepository {
    + save(tokenHash : String, userId : Long, expiresAt : Instant) : void
    + findByTokenHash(tokenHash : String) : RefreshTokenRecord
    + revoke(tokenHash : String) : int
    ' conditional UPDATE ... WHERE revoked_at IS NULL: 1 row claimed,
    ' 0 when the token is unknown or already revoked (rotation TOCTOU fix)
    + revokeAllForUser(userId : Long) : void
  }

  class RefreshTokenRecord <<record>> {
    + userId : Long
    + tokenHash : String
    + expiresAt : Instant
    + revokedAt : Instant
  }

  class AuthService {
    + register(request : RegisterRequest) : void
    + login(request : LoginRequest) : TokenResponse
    + refresh(request : RefreshRequest) : TokenResponse
    + logout(refreshToken : String) : void
    + requestPasswordReset(email : String) : void
    + resetPassword(email : String, code : String, newPassword : String) : void
  }

  class PasswordResetService {
    + requestReset(email : String) : void
    + reset(email : String, code : String, newPassword : String) : boolean
  }

  interface UserCredentialsRepository {
    + save(credentials : UserCredentials) : void
    + findByUserId(userId : Long) : UserCredentials
    + updateHash(userId : Long, newHash : String) : void
  }

  interface PasswordResetTokenRepository {
    + save(token : PasswordResetToken) : void
    + findActiveByUserId(userId : Long, now : Instant) : PasswordResetToken
    + deleteActiveByUserId(userId : Long, now : Instant) : void
    + findLatestCreatedAtByUserId(userId : Long) : Instant
    + countCreatedOnUtcDayByUserId(userId : Long, utcDay : LocalDate) : long
    + deleteExpiredByUserId(userId : Long, now : Instant) : void
    ' The cooldown anchor is the latest row's createdAt (V8 rotation);
    ' the per-UTC-day cap counts the rows created that day; the prune
    ' bounds table growth for active users (S1c).
  }

  interface RateLimiter {
    + tryAcquire(key : String) : Result
    ' Result(acquired : boolean, retryAfterSeconds : Integer) - the exact
    ' seconds until the bucket refills, surfaced in the 429's Retry-After.
  }

  class TokenBucketRateLimiter {
    + tryAcquire(key : String) : Result
    ' Single instance per bucket set (in-memory map) - the app is a
    ' single instance; no cross-instance sharing.
  }

  class ClientIps {
    + {static} resolve(request, trustedProxies, trustLoopback) : String
    ' Real client IP for rate-limit keys: XFF is honored ONLY when the
    ' direct peer is a configured trusted proxy (or trusted loopback), and
    ' then walked RIGHT-TO-LEFT - peel trusted hops until the first
    ' non-trusted entry (a spoofed XFF from an untrusted peer is ignored
    ' entirely).
  }

  class Codes {
    + {static} sixDigitCode() : String
    + {static} randomToken(length : int, alphabet : String) : String
    ' Shared generator for the auth code flows (2026-09-08 W15): reset +
    ' contact change + Tokens draw from ONE SecureRandom; leading zeros
    ' preserved. Verification keeps its own channel-specific generators
    ' (dependency rule: verification must not import auth).
  }

  class Hashes {
    + {static} sha256Hex(raw : String) : String
    + {static} constantTimeEquals(a : String, b : String) : boolean
    ' Thin delegate to verification.CodeHashes (ONE spelling - the
    ' dependency rule keeps the authority below auth). Refresh tokens
    ' at rest are SHA-256 hashed; the ONE-TIME codes (reset / contact
    ' change / verification) are the keyed, domain-separated v2 hash
    ' (PiiCrypto.codeHash) - a 6-digit space is brute-forceable from an
    ' unkeyed dump, the keyed form is not. EVERY stored-vs-presented
    ' compare is constant-time (MessageDigest.isEqual - no early exit).
  }

  class AuthController {
    + register(request : RegisterRequest) : void
    + login(request : LoginRequest) : TokenResponse
    + refresh(request : RefreshRequest) : TokenResponse
    + logout(refreshToken : String) : void
    + requestPasswordReset(request : PasswordResetRequest) : CodeSentDto
    + resetPassword(request : PasswordResetConfirmRequest) : void
  }

  class CodeSentDto <<record>> {
    + resendAvailableAfterSeconds : int
    ' The ack body of every "code sent" endpoint (verification request,
    ' password-reset request, contact-change request): the server-
    ' enforced resend cooldown the client counts down before asking
    ' for the same code again (0 = no cooldown configured).
  }

  class RegisterRequest <<record>> {
    + name : String
    + email : String
    + phone : String
    + password : String
  }

  class LoginRequest <<record>> {
    + emailOrPhone : String
    + password : String
  }

  class RefreshRequest <<record>> {
    + refreshToken : String
  }

  class TokenResponse <<record>> {
    + accessToken : String
    + refreshToken : String
    + expiresIn : int
  }

  class PasswordResetRequest <<record>> {
    + email : String
  }

  class PasswordResetConfirmRequest <<record>> {
    + email : String
    + code : String
    + newPassword : String
  }

  class AccountController {
    + me() : MeResponse
    + updateProfile(request : ProfileUpdateRequest) : MeResponse
    + requestEmailChange(request : ChangeEmailRequest) : CodeSentDto
    + confirmEmailChange(request : ConfirmChangeRequest) : void
    + requestPhoneChange(request : ChangePhoneRequest) : CodeSentDto
    + confirmPhoneChange(request : ConfirmChangeRequest) : void
    + dataExport() : DataExportResponse
    + deleteAccount() : void
    ' All 8 endpoints require JWT (user resolved from the token, never the
    ' body); the two change-request endpoints are additionally per-IP
    ' rate-limited (changeRequestRateLimiter) and ack with the cooldown.
    ' deleteAccount: erasure is a RIGHT of any authenticated user - it
    ' does NOT require identity verification (a user who cannot verify
    ' must not be trapped in the system); the provisioned admin (kind
    ' ADMIN) is refused 403; a repeat call is an idempotent no-op.
  }

  class AccountService {
    + profile(user : RegisteredUser) : MeResponse
    + updateProfile(user : RegisteredUser, request : ProfileUpdateRequest) : MeResponse
    + dataExport(user : RegisteredUser) : DataExportResponse
    ' profile = real profile + REAL verified claims (frontend single source
    ' of truth); updateProfile verifies currentPassword against the Argon2
    ' hash BEFORE any write (wrong -> 401, nothing updated). dataExport =
    ' the caller's own profile + EVERY author-scoped shelter row (all
    ' statuses), one JSON document (legal-recovery).
    + deleteAccount(user : RegisteredUser) : void
    ' The account erasure, ONE transaction (legal-recovery): PURGE the
    ' declared private homes (the submitter's personal data must not
    ' outlive the request); ORPHAN the public community rows (created_by
    ' -> NULL - map data outlives accounts, trust state untouched, the
    ' REJECT note redacted); redact the user's audit reasons; erase the
    ' user row (the DB cascades credentials, claims, pending changes,
    ' tokens, reports). NO verification gate - it is a right, not a
    ' verified-only action; the provisioned admin is refused (403 - the
    ' env vars own that identity). Decision: keep (closing decisions #7).
  }

  class ContactChangeService {
    + requestEmailChange(user : RegisteredUser, newEmail : String) : void
    + confirmEmailChange(user : RegisteredUser, code : String) : ContactChangeResult
    + requestPhoneChange(user : RegisteredUser, newPhone : String) : void
    + confirmPhoneChange(user : RegisteredUser, code : String) : ContactChangeResult
    ' Cross-channel: email change verified by SMS to current phone;
    ' phone change verified by email to current email. The confirm side
    ' RETURNS a code failure (its transaction commits the failed-attempt
    ' increment) instead of throwing - the controller turns it into the
    ' 400 AFTER the commit. The provisioned admin (kind ADMIN) is
    ' refused at EVERY entry point with 403 (its contacts are the
    ' environment's - the e-mail is the seeder's provisioning anchor).
    ' Send-first-then-commit: the code is e-mailed/SMSed OUTSIDE any
    ' transaction, and the pending row (the cooldown anchor) is written
    ' ONLY after the channel accepts a refused send leaves no row and
    ' anchors no cooldown.
  }

  class ContactChangeResult <<record>> {
    + failureMessage : String   ' null on success; otherwise the 400 message
  }

  class PendingContactChange {
    - id : Long
    - userId : Long
    - type : ContactChangeType
    - target : String
    - codeHash : String
    - attempts : int
    - expiresAt : Instant
    - createdAt : Instant
    ' code hashed (keyed, domain-separated - the PiiCrypto v2 slot;
    ' confirm accepts the legacy unkeyed SHA-256 form until its TTL),
    ' attempts-limited, expiring; unique (userId, type) - one pending
    ' change at a time.
  }

  interface PendingContactChangeRepository {
    + findByUserIdAndType(userId : Long, type : ContactChangeType) : Optional<PendingContactChange>
    + save(change : PendingContactChange) : PendingContactChange
    + delete(change : PendingContactChange) : void
    ' Atomic attempt counter (a conditional UPDATE - a read-modify-write
    ' would lose updates under a concurrent wrong-code burst): 0 rows
    ' updated = another confirm already reached the cap.
    + incrementAttempts(id : Long, maxAttempts : int) : int
  }

  class AdminSeeder {
    ' The env-provisioned admin (admin-moderation D1): an ApplicationRunner
    ' - runs ONCE at startup, transactional. Create-if-absent is the whole
    ' contract (see the note below).
    ' A password shorter than 8 characters REFUSES the boot (an
    ' IllegalStateException the deploy must notice, not a warning).
    - email : String        ' app.admin.email  = ${ADMIN_EMAIL:}  (empty default)
    - password : String     ' app.admin.password = ${ADMIN_PASSWORD:} (empty default)
    + run(args : ApplicationArguments) : void
  }

  class ProfileUpdateRequest <<record>> {
    + name : String
    + currentPassword : String
  }

  class MeResponse <<record>> {
    + name : String
    + email : String
    + phone : String
    + levels : List<VerificationLevel>
    + isAdmin : boolean  ' admin-moderation D2: always present; true iff the
                         ' freshly loaded user's KIND is ADMIN (kind is the
                         ' truth - never a token claim). Gates the frontend
                         ' nav item + the /admin route.
  }

  class ChangeEmailRequest <<record>> {
    + newEmail : String
  }

  class ChangePhoneRequest <<record>> {
    + newPhone : String
  }

  class ConfirmChangeRequest <<record>> {
    + code : String
  }
}

' ============ EXTERNAL CONTRACTS (defined in 01, shown here as contracts only) ============
package "referenced from 01 (contracts only)" {
  class "RegisteredUser" as RU {
    - id : Long
    - email : String
    - phone : String
  }

  class "UserService" as US {
    + findByEmailOrPhone(contact : String) : RegisteredUser
    + findByEmail(email : String) : RegisteredUser
  }

  interface "UserRepository" as UR {
    + save(user : User) : void
    + findByEmail(email : String) : RegisteredUser
    ' The seeder's create-if-absent check (REGISTERED and ADMIN rows both
    ' count - case-insensitive). Also the fresh isAdmin(userId) kind lookup
    ' behind every /admin/* request (defined in 01; admin-moderation D2).
  }

  interface SmtpSender {
    + send(email : String, message : String) : boolean
    ' true = accepted, false = refused (logged, never thrown); a refused
    ' send writes no pending row and anchors no cooldown.
  }

  interface SmsSender {
    + send(phone : String, message : String) : boolean
  }

  enum "VerificationLevel" as VL {
    EMAIL
    PHONE
    SMART_ID
  }

  enum "ContactChangeType" as CCT {
    EMAIL_CHANGE
    PHONE_CHANGE
  }
}

' ==================== IMPLEMENTATIONS (Ch 9: interface first) ====================
Argon2PasswordHasher ..|> PasswordHasher
JwtTokenService ..|> TokenService
TokenBucketRateLimiter ..|> RateLimiter

' ==================== SERVICE WIRING ====================
AuthController --> AuthService : all auth endpoints
AuthController ..> RateLimiter : 6 buckets - register per IP; login per (IP, normalized contact) + per-IP aggregate; refresh + logout = session per IP; reset-request + reset-confirm per (IP, email)
AuthController ..> RollingContactOtpLimiter : per-e-mail rolling cap on registration ATTEMPTS ("register:" namespace; a hit lands in the alert ring, then 429 + Retry-After)
AuthController ..> ClientIps : resolves the rate-limit key IP
AuthController ..> Codes : normalizes the login contact for the key (email lowercased; phone E.164 then lowercased)

AuthService --> UserService : profile lookup (register/login/reset)
AuthService --> PasswordHasher : hash / verify
AuthService --> UserCredentialsRepository : stores & reads hash
AuthService --> TokenService : issue / refresh / revoke sessions
AuthService --> PasswordResetService : delegates reset flow
AuthService --> RefreshTokenRepository : revokeAll on password reset

AdminSeeder --> UR : create-if-absent check + save (interface, 01)
AdminSeeder --> UserCredentialsRepository : stores the Argon2 hash
AdminSeeder ..> PasswordHasher : the SAME encoder registration uses

AccountController --> AccountService : me / profile
AccountController --> ContactChangeService : all contact-change endpoints
AccountController ..> RateLimiter : guards change-request endpoints (per IP)
AccountService --> UserCredentialsRepository : current-password check + write
ContactChangeService --> PendingContactChangeRepository : pending change (cooldown anchor)
ContactChangeService --> SmsSender : email-change code -> current phone
ContactChangeService --> SmtpSender : phone-change code -> current email
ContactChangeService --> RegisteredUser : changeEmail() / changePhone()
PendingContactChange --> ContactChangeType

PasswordResetService --> UserService : findByEmail
PasswordResetService --> PasswordResetTokenRepository : one active code per user
PasswordResetService --> SmtpSender : reset code email (6-digit, no link)
PasswordResetService --> UserCredentialsRepository : update hash
PasswordResetService --> PasswordHasher : hash new password
PasswordResetService ..> Codes : sixDigitCode()
MeResponse --> VerificationLevel : real verified claims (enum order)

TokenService --> RefreshTokenRepository : persists refresh tokens
JwtTokenService ..> RefreshTokenRepository

UserCredentials --> RU : belongs to (by userId)
PasswordResetToken --> RU : belongs to (by userId)

note bottom of UserCredentials
  Separate aggregate from RegisteredUser (01) ON PURPOSE:
  profile PII and password secrets live apart - a leak of one
  table does not leak the other. Argon2id embeds the salt in
  the hash string (no separate salt column). Never store or
  log plaintext passwords.
end note

note bottom of TokenService
  Two-token session model (SDI Ch 7 style):
    access  = JWT, 15 min, stateless, signed - the map API
              trusts it without DB lookups
    refresh = 30 days, stored HASHED via RefreshTokenRepository
              -> revocable (logout, reset, compromise)
  JwtTokenService implements signing/validation + exp/sub claims.
end note

note bottom of PasswordResetService
  Reset flow (emailed 6-digit code - no URL link), three phases:
    1. decide() - one consistent read+prune snapshot: unknown e-mail ->
       SILENT no-op (still the same 200, anti-enumeration kept); the
       provisioned admin (kind ADMIN) -> 403 NAMING the environment
       provisioning (a code e-mailed to its address would let anyone who
       finds the mailbox re-key the deployment); 60 s re-issue cooldown
       (anchored at the latest row's createdAt - V8 rotation) + max 5 per
       UTC day -> SILENT no-op
    2. the send, OUTSIDE any transaction: a FRESH 6-digit code (shared
       Codes.sixDigitCode(), same generator as contact-change); a REFUSED
       send writes no token row and anchors no cooldown (the outage costs
       the user nothing, the retry is not suppressed)
    3. the write, one transaction (atomic one-active-code): delete the
       user's prior active code, store {tokenHash = the KEYED,
       domain-separated v2 hash (PiiCrypto.codeHash) of the code - a
       6-digit space is brute-forceable from an unkeyed dump, the legacy
       unkeyed SHA-256 form is still matched until its TTL, expiresAt =
       now + 15 min, attempts = 0}
  reset(email, code, newPwd) - ONE transaction:
    4. the provisioned admin's e-mail is refused 403 first (no code can
       be issued for it, and a direct call must not rewrite the env's
       credentials)
    5. find the account's active code; verify attempts < 5 + hash match
       (CodeHashes.matches - v2 or legacy, constant-time) + unused + not
       expired; a wrong code PERSISTS its attempt increment (its failure
       must not roll back the counter - reset() returns a boolean and the
       controller answers the one generic 400 after the commit)
    6. on success: hash the new password, update UserCredentials, mark
       the code used (its hash is never re-usable, even before expiry),
       revoke ALL refresh tokens for that user (stolen-session protection
       - old sessions die on reset)
end note

note bottom of AuthController
  Thin HTTP shell - zero logic, just wiring (Ch 1). permitAll = exactly
  these 6 POST /auth/* endpoints (register, login, refresh, logout,
  password-reset request + confirm); GET /api/shelters/** (except /mine)
  + GET /api/data-source (M5 provenance read) + GET /api/site-texts
  (the public site copy) + GET /api/guidance/** (the /blog crisis
  reads) + GET and HEAD /api/media/** (public media serving - the crisis
  hero images; every other method stays authenticated) + actuator
  health/info are the only other open routes; /swagger-ui + /v3/api-docs
  are open in the dev/test profiles only (Profiles.isDevTestOnly - the
  document is the full attack surface) - everything else is JWT (see
  04-CONTEXT-AUTH wiring). Rate limiting (2026-09-08 hardened, SDI Ch 4
  token bucket, keys via ClientIps):
    - /auth/register          per client IP (account spam) PLUS a rolling
                              per-e-mail cap on registration ATTEMPTS
                              (RollingContactOtpLimiter, "register:" - every
                              attempt counts, a 409 retry included; a hit
                              lands in the admin alert ring before the
                              429 + Retry-After)
    - /auth/login             per (IP, normalized contact) AND a per-IP
                              aggregate bucket (credential stuffing);
                              contact key = email lowercased or phone
                              E.164-lowered
    - /auth/refresh + /auth/logout  one SHARED session bucket per client IP
    - /auth/password-reset/   per (IP, email)
        request
    - /auth/password-reset/   per (IP, email) anti-guess bucket - a 6-digit
        confirm                       code must not be brute-forceable
    - /api/geo/resolve        per client IP (5/min) - short-link resolver;
                              LocationController is defined in the shelter
                              context (05), listed here because it shares
                              this RateLimiter bucket set
  end note

note bottom of ContactChangeService
  CROSS-CHANNEL contact change (hardening against single-channel
  compromise): changing the email requires an SMS code sent to the
  CURRENT phone; changing the phone requires an email code sent to
  the CURRENT email. Stealing only one channel is not enough.
  One pending change per (user, type): resend cooldown (60 s),
  code TTL (15 min), 5-attempt limit, duplicate target -> 409,
  per-IP rate limit on the request endpoints.
end note

note bottom of MeResponse
  profile = real profile + REAL verified claims + isAdmin (admin-moderation
  D2): the frontend's single source of truth - the nav item and the /admin
  route guard read isAdmin; it is the freshly loaded user's KIND (true only
  for the ADMIN-kind row), never derived from any token claim.
end note

note bottom of AdminSeeder
  ENV-PROVISIONED ADMIN (admin-moderation D1) - the admin comes from the
  environment, never the registration flow (the mailbox does not exist and
  can never pass email verification):
    1. Either ADMIN_EMAIL / ADMIN_PASSWORD empty -> NO-OP. No admin exists,
       /admin/* answers 403 for everyone (kind is the truth - a normal
       account holding the email string stays a normal account), and the
       app behaves exactly as without the capability (dev boxes without the
       vars keep working; prod is opt-in).
    2. A user with that email ALREADY exists (any kind; the lookup is
       case-insensitive) -> NO-OP. The seeder NEVER re-hashes, flips kind or
       touches claims - an in-app password change survives restarts and
       deployments.
    3. Otherwise -> create: AdminUser.provisioned("Admin", email, clock.instant()) -
       kind ADMIN, name "Admin", NO phone (null - outside the partial unique
       index, never a login route), no national ID code stored (M1 - the
       pre-set SMART_ID claim carries the e-mail as its external ref),
       EVERY verification claim pre-set (EMAIL/PHONE/SMART_ID - canWrite()
       true from the first request) + UserCredentials with the Argon2 hash
       of ADMIN_PASSWORD (the same encoder registration uses).
  Login is the NORMAL POST /auth/login (emailOrPhone + password) - no
  dedicated endpoint, no backdoor, same JWT shape as every other user
  (principal = userId, NO role claim - D2: /admin/* authorizes by a fresh
  UserKind.ADMIN lookup per request, so a demotion takes effect on the very
  next request).
  OPS - de-provisioning: remove BOTH env vars AND delete the row (manual
  SQL - no API deletes admin accounts). While both vars stay set, the
  seeder RECREATES the admin on the next boot if the row was deleted
  (create-if-absent sees no user with that email); with the vars removed it
  is a no-op forever, but a still-existing row remains a working admin
  (login with its own stored password) - row deletion is the real off switch.
end note

note bottom of US
  Defined in 01 (app context). Shown here with the lookup
  methods the auth context requires - contracts only.
end note
@enduml
