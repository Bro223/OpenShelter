@startuml
title Shelter Map - Authentication & Password Reset (auth context)

' ============================================================
' AUTH BOUNDED CONTEXT - developed independently (parallel work)
' Depends only on CONTRACTS from other contexts:
'   - UserService (app context, 01)  -> profile lookup
'   - RegisteredUser (domain, 01)    -> identity
'   - SmtpSender (verification, 01)  -> reset email channel
' Three concerns kept separate (no blob service):
'   VERIFICATION (01)  = prove you own a contact -> claims
'   AUTHENTICATION     = prove you are the same person -> password
'   PASSWORD RESET     = recover auth via the VERIFIED email
' ============================================================

package "auth" {
  class UserCredentials {
    - userId : Long
    - passwordHash : String
    - createdAt : Instant
    - changedAt : Instant
    --
    + UserCredentials(userId : Long, passwordHash : String)
  }

  class PasswordResetToken {
    - id : Long
    - userId : Long
    - tokenHash : String
    - expiresAt : Instant
    - usedAt : Instant
    - attempts : int
  }

  interface PasswordHasher {
    + hash(plain : String) : String
    + verify(plain : String, hash : String) : boolean
  }

  class Argon2PasswordHasher {
    + hash(plain : String) : String
    + verify(plain : String, hash : String) : boolean
  }

  interface TokenService {
    + issue(user : RegisteredUser) : TokenResponse
    + refresh(refreshToken : String) : TokenResponse
    + revoke(refreshToken : String) : void
  }

  class JwtTokenService {
    + issue(user : RegisteredUser) : TokenResponse
    + refresh(refreshToken : String) : TokenResponse
    + revoke(refreshToken : String) : void
  }

  interface RefreshTokenRepository {
    + save(tokenHash : String, userId : Long, expiresAt : Instant) : void
    + findByTokenHash(tokenHash : String) : RefreshTokenRecord
    + revoke(tokenHash : String) : void
    + revokeAllForUser(userId : Long) : void
  }

  class RefreshTokenRecord <<record>> {
    + userId : Long
    + tokenHash : String
    + expiresAt : Instant
    + revokedAt : Instant
  }

  class AuthService {
    + register(request : RegisterRequest) : void
    + login(request : LoginRequest) : TokenResponse
    + refresh(request : RefreshRequest) : TokenResponse
    + logout(refreshToken : String) : void
    + requestPasswordReset(email : String) : void
    + resetPassword(email : String, code : String, newPassword : String) : void
  }

  class PasswordResetService {
    + requestReset(email : String) : void
    + reset(email : String, code : String, newPassword : String) : boolean
  }

  interface UserCredentialsRepository {
    + save(credentials : UserCredentials) : void
    + findByUserId(userId : Long) : UserCredentials
    + updateHash(userId : Long, newHash : String) : void
  }

  interface PasswordResetTokenRepository {
    + save(token : PasswordResetToken) : void
    + findByTokenHash(tokenHash : String) : PasswordResetToken
    + findActiveByUserId(userId : Long, now : Instant) : PasswordResetToken
    + deleteActiveByUserId(userId : Long, now : Instant) : void
    + markUsed(id : Long) : void
  }

  interface RateLimiter {
    + tryAcquire(key : String) : boolean
  }

  class TokenBucketRateLimiter {
    + tryAcquire(key : String) : boolean
    ' Single instance per bucket set (in-memory map) - the app is a
    ' single instance; no cross-instance sharing.
  }

  class ClientIps {
    + {static} resolve(request, trustedProxies, trustLoopback) : String
    ' Real client IP for rate-limit keys: XFF is honored ONLY when the
    ' direct peer is a configured trusted proxy (or trusted loopback), and
    ' then walked RIGHT-TO-LEFT - peel trusted hops until the first
    ' non-trusted entry (a spoofed XFF from an untrusted peer is ignored
    ' entirely).
  }

  class Codes {
    + {static} sixDigitCode() : String
    + {static} randomToken(length : int, alphabet : String) : String
    ' Shared generator for the auth code flows (2026-09-08 W15): reset +
    ' contact change + Tokens draw from ONE SecureRandom; leading zeros
    ' preserved. Verification keeps its own channel-specific generators
    ' (dependency rule: verification must not import auth).
  }

  class Hashes {
    + {static} sha256Hex(raw : String) : String
    + {static} constantTimeEquals(a : String, b : String) : boolean
    ' Tokens at rest are SHA-256 hashed; EVERY stored-vs-presented compare
    ' is constant-time (MessageDigest.isEqual - no early exit, W9).
  }

  class AuthController {
    + register(request : RegisterRequest) : void
    + login(request : LoginRequest) : TokenResponse
    + refresh(request : RefreshRequest) : TokenResponse
    + logout(refreshToken : String) : void
    + requestPasswordReset(request : PasswordResetRequest) : void
    + resetPassword(request : PasswordResetConfirmRequest) : void
  }

  class RegisterRequest <<record>> {
    + name : String
    + email : String
    + phone : String
    + nationalIdCode : String
    + password : String
  }

  class LoginRequest <<record>> {
    + emailOrPhone : String
    + password : String
  }

  class RefreshRequest <<record>> {
    + refreshToken : String
  }

  class TokenResponse <<record>> {
    + accessToken : String
    + refreshToken : String
    + expiresIn : int
  }

  class PasswordResetRequest <<record>> {
    + email : String
  }

  class PasswordResetConfirmRequest <<record>> {
    + email : String
    + code : String
    + newPassword : String
  }

  class AccountController {
    + me() : MeResponse
    + updateProfile(request : ProfileUpdateRequest) : MeResponse
    + requestEmailChange(request : ChangeEmailRequest) : void
    + confirmEmailChange(request : ConfirmChangeRequest) : void
    + requestPhoneChange(request : ChangePhoneRequest) : void
    + confirmPhoneChange(request : ConfirmChangeRequest) : void
    + myReviews() : List<MyReviewDto>
    ' All 7 endpoints require JWT (user resolved from the token, never the
    ' body); the two change-request endpoints are additionally per-IP
    ' rate-limited (changeRequestRateLimiter).
  }

  class AccountService {
    + profile(user : RegisteredUser) : MeResponse
    + updateProfile(user : RegisteredUser, request : ProfileUpdateRequest) : MeResponse
    + myReviews(user : RegisteredUser) : List<MyReviewDto>
    ' profile = real profile + REAL verified claims (frontend single source
    ' of truth); updateProfile verifies currentPassword against the Argon2
    ' hash BEFORE any write (wrong -> 401, nothing updated); myReviews =
    ' the caller's reviews across ALL shelters, shelter names batched
    ' (ShelterRepository.findByIds - no N+1).
  }

  class ContactChangeService {
    + requestEmailChange(user : RegisteredUser, newEmail : String) : void
    + confirmEmailChange(user : RegisteredUser, code : String) : void
    + requestPhoneChange(user : RegisteredUser, newPhone : String) : void
    + confirmPhoneChange(user : RegisteredUser, code : String) : void
    ' Cross-channel: email change verified by SMS to current phone;
    ' phone change verified by email to current email.
  }

  class PendingContactChange {
    - id : Long
    - userId : Long
    - type : ContactChangeType
    - target : String
    - codeHash : String
    - attempts : int
    - expiresAt : Instant
    - createdAt : Instant
    ' code hashed (SHA-256), attempts-limited, expiring;
    ' unique (userId, type) - one pending change at a time.
  }

  interface PendingContactChangeRepository {
    + findByUserIdAndType(userId : Long, type : ContactChangeType) : Optional<PendingContactChange>
    + save(change : PendingContactChange) : PendingContactChange
    + delete(change : PendingContactChange) : void
  }

  class ProfileUpdateRequest <<record>> {
    + name : String
    + nationalIdCode : String
    + currentPassword : String
  }

  class MeResponse <<record>> {
    + name : String
    + email : String
    + phone : String
    + nationalIdCode : String
    + levels : List<VerificationLevel>
  }

  class MyReviewDto <<record>> {
    ' One row of GET /account/reviews/mine - the caller's review of a
    ' shelter, carrying the shelter's id + name for navigation.
    + shelterId : long
    + shelterName : String
    + rating : int
    + comment : String
    + createdAt : Instant
    + updatedAt : Instant
  }

  class ChangeEmailRequest <<record>> {
    + newEmail : String
  }

  class ChangePhoneRequest <<record>> {
    + newPhone : String
  }

  class ConfirmChangeRequest <<record>> {
    + code : String
  }
}

' ============ EXTERNAL CONTRACTS (defined in 01, shown here as contracts only) ============
package "referenced from 01 (contracts only)" {
  class "RegisteredUser" as RU {
    - id : Long
    - email : String
    - phone : String
  }

  class "UserService" as US {
    + findByEmailOrPhone(contact : String) : RegisteredUser
    + findByEmail(email : String) : RegisteredUser
  }

  interface SmtpSender {
    + send(email : String, message : String) : void
  }

  interface SmsSender {
    + send(phone : String, message : String) : void
  }

  enum "VerificationLevel" as VL {
    EMAIL
    PHONE
    SMART_ID
  }

  enum "ContactChangeType" as CCT {
    EMAIL_CHANGE
    PHONE_CHANGE
  }
}

' ==================== IMPLEMENTATIONS (Ch 9: interface first) ====================
Argon2PasswordHasher ..|> PasswordHasher
JwtTokenService ..|> TokenService
TokenBucketRateLimiter ..|> RateLimiter

' ==================== SERVICE WIRING ====================
AuthController --> AuthService : all auth endpoints
AuthController ..> RateLimiter : 5 buckets - register per IP; login per (IP, normalized contact) + per-IP aggregate; reset-request + reset-confirm per (IP, email)
AuthController ..> ClientIps : resolves the rate-limit key IP
AuthController ..> Codes : normalizes the login contact for the key (email lowercased; phone E.164 then lowercased)

AuthService --> UserService : profile lookup (register/login/reset)
AuthService --> PasswordHasher : hash / verify
AuthService --> UserCredentialsRepository : stores & reads hash
AuthService --> TokenService : issue / refresh / revoke sessions
AuthService --> PasswordResetService : delegates reset flow
AuthService --> RefreshTokenRepository : revokeAll on password reset

AccountController --> AccountService : me / profile / myReviews
AccountController --> ContactChangeService : all contact-change endpoints
AccountController ..> RateLimiter : guards change-request endpoints (per IP)
AccountService --> UserCredentialsRepository : current-password check + write
ContactChangeService --> PendingContactChangeRepository : pending change (cooldown anchor)
ContactChangeService --> SmsSender : email-change code -> current phone
ContactChangeService --> SmtpSender : phone-change code -> current email
ContactChangeService --> RegisteredUser : changeEmail() / changePhone()
PendingContactChange --> ContactChangeType

PasswordResetService --> UserService : findByEmail
PasswordResetService --> PasswordResetTokenRepository : one active code per user
PasswordResetService --> SmtpSender : reset code email (6-digit, no link)
PasswordResetService --> UserCredentialsRepository : update hash
PasswordResetService --> PasswordHasher : hash new password
PasswordResetService ..> Codes : sixDigitCode()
MeResponse --> VerificationLevel : real verified claims (enum order)

TokenService --> RefreshTokenRepository : persists refresh tokens
JwtTokenService ..> RefreshTokenRepository

UserCredentials --> RU : belongs to (by userId)
PasswordResetToken --> RU : belongs to (by userId)

note bottom of UserCredentials
  Separate aggregate from RegisteredUser (01) ON PURPOSE:
  profile PII and password secrets live apart - a leak of one
  table does not leak the other. Argon2id embeds the salt in
  the hash string (no separate salt column). Never store or
  log plaintext passwords.
end note

note bottom of TokenService
  Two-token session model (SDI Ch 7 style):
    access  = JWT, 15 min, stateless, signed - the map API
              trusts it without DB lookups
    refresh = 30 days, stored HASHED via RefreshTokenRepository
              -> revocable (logout, reset, compromise)
  JwtTokenService implements signing/validation + exp/sub claims.
end note

note bottom of PasswordResetService
  Reset flow (emailed 6-digit code - no URL link):
    1. requestReset(email) -> 6-digit code (shared Codes.sixDigitCode(),
       same generator as contact-change); per-user re-issue throttle
       (2026-09-08 W1/S1b): 60 s rotation cooldown + max 5 per UTC day -
       either hit is a SILENT no-op (still 200, anti-enumeration kept);
       otherwise delete the user's prior active code (one active code per
       user)
    2. store {tokenHash = SHA-256(code), expiresAt=15min, usedAt,
       attempts=0} - hashed, single-use, 5-attempt limit (V6)
    3. ALWAYS respond success ("if the account exists, we sent an
       email") - never reveal whether an email is registered
    4. send "Shelter Map password reset code: NNNNNN (valid 15 min)"
       via SmtpSender (no URL, no app.frontend.base-url)
    5. reset(email, code, newPwd) -> find the account's active code,
       verify attempts < 5 + hash (Hashes.constantTimeEquals) + expiry +
       unused, hash new password, update UserCredentials, mark code used
    6. revoke ALL refresh tokens for that user (stolen-session
       protection - old sessions die on reset)
    7. ONE transaction for 5+6; ANY failure (unknown email / no code /
       over-limit / wrong / expired / used) -> ONE generic 400
end note

note bottom of AuthController
  Thin HTTP shell - zero logic, just wiring (Ch 1). permitAll = exactly
  these 6 POST /auth/* endpoints (register, login, refresh, logout,
  password-reset request + confirm); GET /api/shelters/** (except /mine)
  + actuator health/info are the only other open routes - everything else
  is JWT (see 04-CONTEXT-AUTH wiring). Rate limiting (2026-09-08
  hardened, SDI Ch 4 token bucket, keys via ClientIps):
    - /auth/register          per client IP (account spam)
    - /auth/login             per (IP, normalized contact) AND a per-IP
                              aggregate bucket (credential stuffing);
                              contact key = email lowercased or phone
                              E.164-lowered
    - /auth/password-reset/   per (IP, email)
        request
    - /auth/password-reset/   per (IP, email) anti-guess bucket - a 6-digit
        confirm                       code must not be brute-forceable
end note

note bottom of ContactChangeService
  CROSS-CHANNEL contact change (hardening against single-channel
  compromise): changing the email requires an SMS code sent to the
  CURRENT phone; changing the phone requires an email code sent to
  the CURRENT email. Stealing only one channel is not enough.
  One pending change per (user, type): resend cooldown (60 s),
  code TTL (15 min), 5-attempt limit, duplicate target -> 409,
  per-IP rate limit on the request endpoints.
end note

note bottom of US
  Defined in 01 (app context). Shown here with the lookup
  methods the auth context requires - contracts only.
end note
@enduml
