<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>ee.sheltermap</groupId>
    <artifactId>shelter-map</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>shelter-map</name>
    <description>Shelter Map backend — Estonia bomb-shelter map (backend only)</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.7</jjwt.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- 2.6.x is the springdoc line aligned to Boot 3.3.x / Java 21.
             2.7+ targets Boot 3.4+ — do not bump without review (SW-A1). -->
        <springdoc.version>2.6.0</springdoc.version>
        <!-- HTML sanitizer for admin-authored guidance bodies
             (crisis-guidance D2). Bumps need review: the parser behaviour
             is part of the security boundary, not just a version number. -->
        <jsoup.version>1.23.2</jsoup.version>
    </properties>

    <dependencies>
        <!-- Web / API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- API documentation (SW wave): runtime OpenAPI document + Swagger UI.
             Dev-gated by SPRINGDOC_ENABLED (default off in both yml files) and
             refused at boot on non-dev/test profiles by ApiDocsGuard — the same
             fail-closed shape as the /dev/* diagnostic guards. NOT the v1
             artifact, not the webflux starter, and deliberately NO
             springdoc-openapi-starter-actuator: the document must not absorb
             the /actuator surface (application.yml exposes health,info only). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Persistence: JPA + Flyway + PostgreSQL 16 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Security / Auth: Spring Security + crypto + jjwt 0.12.x -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Mail: real SMTP channel (SmtpPulseSmtpSender via spring.mail.*) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Loads the local .env file (project root) into Spring's environment at
             startup — keeps real credentials (SMTP_*, MAIL_PROVIDER, ...) out of
             git and out of every launch command. .env is gitignored. -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- Argon2PasswordEncoder (spring-security-crypto) needs BouncyCastle's Argon2 generator -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <!-- EPSG:3301 (L-EST97) -> EPSG:4326 (WGS84) for Maa-amet WFS coordinates -->
        <dependency>
            <groupId>org.locationtech.proj4j</groupId>
            <artifactId>proj4j</artifactId>
            <version>1.3.0</version>
        </dependency>
        <!-- Twilio Programmable Messaging: production SMS channel (send-only).
             Twilio is only the transport — OTP generation, retry/cooldown and
             verification logic live on the OpenShelter side (PhoneVerificationProvider
             + VerificationService), so the provider stays swappable via app.sms.provider. -->
        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>10.9.2</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- HTML sanitizer for crisis-guidance bodies (crisis-guidance D2).
             A LIBRARY, deliberately not hand-rolled: sanitizer bypasses
             come from parser DIFFERENTIALS between what the sanitizer
             parses and what the browser executes, so the parser must be a
             maintained implementation (jsoup) with the allowlist declared
             on top (BodySanitizer's Safelist). This is the ONLY new
             dependency of the crisis-guidance change; no npm change. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- Ops / health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test: JUnit 5 + AssertJ (via starter-test) + Testcontainers (Postgres) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
