<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ee.sheltermap</groupId>
    <artifactId>shelter-map</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>shelter-map</name>
    <description>Shelter Map backend — Estonia bomb-shelter map (backend only)</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.7</jjwt.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- Enforcement-lane (W2-C) tool versions. These are BUILD tooling,
             not app dependencies: they never enter the runtime classpath. -->
        <pmd.version>3.27.0</pmd.version>
        <pmd-core.version>7.27.0</pmd-core.version>
        <jacoco.version>0.8.13</jacoco.version>
        <dependency-check.version>12.1.9</dependency-check.version>
        <!-- 2.8.x is the springdoc line aligned to Boot 3.4.x/3.5.x / Java 21.
             2.6.x is binary-incompatible with Spring 6.2 (it calls the
             ControllerAdviceBean(Object) constructor removed in 6.2 —
             NoSuchMethodError from GenericResponseService, /v3/api-docs 500s),
             so the 3.4+ parent forces the move (SW-A1). -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- HTML sanitizer for admin-authored guidance bodies
             (crisis-guidance D2). Bumps need review: the parser behaviour
             is part of the security boundary, not just a version number. -->
        <jsoup.version>1.23.2</jsoup.version>
        <!-- W3-C dependency-advisory bumps. These OVERRIDE the versions the
             Boot 3.5.16 parent manages (tomcat 10.1.55, jackson-bom 2.21.4,
             commons-lang3 3.17.0) — the same-property-name override is the
             sanctioned Boot mechanism, so no dependencyManagement entry is
             needed. Each is a patch/minor bump WITHIN the managed line
             (no major, no API change); the full suite is the behavior proof.
             The matching suppressions in dependency-check-suppressions.xml
             are deleted as the acceptance proof. -->
        <tomcat.version>10.1.60</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <commons-lang3.version>3.19.0</commons-lang3.version>
        <!-- DEPS-BUMP (2026-09-23): clear the gate-failing findings (CVSS max(v3,v4) >= 7)
             the nightly dependency-scan reports. Same-property-name overrides of the
             Boot 3.5.16 managed versions — the same sanctioned mechanism as the W3-C
             bumps above; each is a patch/minor bump WITHIN the managed line (no major,
             no API change); the full suite is the behavior proof. No suppressions added.
             NOT clearable on the 3.5.x line (6.2/6.5 ended at 6.2.19/6.5.11; the fix
             releases 6.2.20/6.5.12 do not exist on Central) — needs the Boot 4.x /
             Spring 7 major migration, reported, not suppressed:
             spring-core 6.2.19 (CVE-2026-47884, CVSS 9.8, + 11 more on the 6.2 line)
             and spring-security-core 6.5.11 (CVE-2026-59270, CVSS 9.1, + CVE-2026-47841).
             - postgresql 42.7.11 -> 42.7.12: CVE-2026-54291 (CVSS 8.2, silent
               SCRAM-SHA-256-PLUS channel-binding downgrade); 42.7.12 is the fix release
               (pgjdbc GHSA-j92g-9f8w-j867), the smallest version that clears it.
             - log4j2 2.24.3 -> 2.25.5: CVE-2026-34479 (CVSS v3 7.5, Log4j1XmlLayout
               emits XML 1.0-forbidden characters); the fix is 2.25.4, and 2.25.5
               additionally clears CVE-2026-49844 (v3 5.9, below the gate) so no
               log4j finding from the 2.24 line remains in the report. -->
        <postgresql.version>42.7.12</postgresql.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <!-- Web / API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- API documentation (SW wave): runtime OpenAPI document + Swagger UI.
             Dev-gated by SPRINGDOC_ENABLED (default off in both yml files) and
             refused at boot on non-dev/test profiles by ApiDocsGuard — the same
             fail-closed shape as the /dev/* diagnostic guards. NOT the v1
             artifact, not the webflux starter, and deliberately NO
             springdoc-openapi-starter-actuator: the document must not absorb
             the /actuator surface (application.yml exposes health,info only). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Persistence: JPA + Flyway + PostgreSQL 16 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Security / Auth: Spring Security + crypto + jjwt 0.12.x -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Mail: real SMTP channel (SmtpPulseSmtpSender via spring.mail.*) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Loads the local .env file (project root) into Spring's environment at
             startup — keeps real credentials (SMTP_*, MAIL_PROVIDER, ...) out of
             git and out of every launch command. .env is gitignored. -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- Argon2PasswordEncoder (spring-security-crypto) needs BouncyCastle's Argon2 generator -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <!-- EPSG:3301 (L-EST97) -> EPSG:4326 (WGS84) for Maa-amet WFS coordinates -->
        <dependency>
            <groupId>org.locationtech.proj4j</groupId>
            <artifactId>proj4j</artifactId>
            <version>1.3.0</version>
        </dependency>
        <!-- Twilio Programmable Messaging: production SMS channel (send-only).
             Twilio is only the transport — OTP generation, retry/cooldown and
             verification logic live on the OpenShelter side (PhoneVerificationProvider
             + VerificationService), so the provider stays swappable via app.sms.provider. -->
        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>10.9.2</version>
            <exclusions>
                <!-- The API is JSON-only (review 06, finding 1): this artifact
                     transitively carries jackson-dataformat-xml, whose presence
                     on the classpath makes Boot auto-configure the XML message
                     converter, so a browser-style Accept used to answer
                     application/xhtml+xml although every operation in
                     docs/api/openapi.json declares application/json
                     (JsonOnlyContentNegotiationIT pins this). NOT via springdoc:
                     swagger-core-jakarta brings only jackson-dataformat-yaml.
                     Twilio needs the jar only for TwiML.fromXml — the app sends
                     via Message.creator (JSON REST), and the Twilio version is
                     unchanged. -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>jackson-dataformat-xml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- HTML sanitizer for crisis-guidance bodies (crisis-guidance D2).
             A LIBRARY, deliberately not hand-rolled: sanitizer bypasses
             come from parser DIFFERENTIALS between what the sanitizer
             parses and what the browser executes, so the parser must be a
             maintained implementation (jsoup) with the allowlist declared
             on top (BodySanitizer's Safelist). This is the ONLY new
             dependency of the crisis-guidance change; no npm change. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- Ops / health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test: JUnit 5 + AssertJ (via starter-test) + Testcontainers (Postgres) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Static analysis (W2-C, P2-16): PMD, high severity only.
                 All standard Java categories, failing on high-or-worse
                 (minimumPriority=2 / failurePriority=2). Two rules that
                 conflict with the codebase's documented SLF4J idiom are
                 lowered to priority 5 in pmd-ruleset.xml (reasons
                 documented there); the pre-existing findings measured at
                 landing are excluded via pmd-exclude-from-failure.properties
                 (that file is the manifest of the excluded debt, owned per
                 lane). `mvn verify` runs the check; a NEW high-severity
                 finding fails the build. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd-core.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd-core.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetJdk>21</targetJdk>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <!-- PMD 7 severity is derived from priority: 1 = critical,
                         2 = high, 3 = medium, 4-5 = low. Report AND fail on
                         high-or-worse only (the plan's first gate level);
                         medium findings still appear in target/pmd.xml as
                         warnings, they just do not fail the build. -->
                    <minimumPriority>2</minimumPriority>
                    <failurePriority>2</failurePriority>
                    <!-- pmd-ruleset.xml: all standard Java categories
                         (the plan's first gate level) plus two documented
                         priority-5 overrides for rules that conflict with
                         this codebase's SLF4J idiom. The pre-existing
                         findings measured at landing are excluded via
                         pmd-exclude-from-failure.properties (that file is
                         the manifest of the excluded debt), so the gate
                         fails on NEW violations only. -->
                    <rulesets>
                        <ruleset>pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <excludeFromFailureFile>pmd-exclude-from-failure.properties</excludeFromFailureFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage gate (W2-C, P2-16): the floor is the MEASURED line
                 coverage of HEAD at landing (2026-09-22, branch
                 feature/frontend, clean git-archive checkout, full suite:
                 1172 tests, JaCoCo 0.8.13): 6291/6703 lines = 0.9385.
                 The floor sits at 0.93 — below the measurement, never
                 above it, per the plan. Raising it is a decision with a
                 new measurement in the commit message; lowering it needs
                 one too. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.93</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Dependency scan (W2-C, P2-16): OWASP Dependency-Check
                 against the NVD feed, failing on CVSS >= 7. Known findings
                 that this branch legitimately carries (the dependency
                 bump is W3-C, not this lane) are documented one-by-one in
                 dependency-check-suppressions.xml with their owner and
                 expiry — a suppression without a reason and a lane is a
                 hole in the gate. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <!-- File-backed NVD database: the plugin default is an
                         in-memory H2 that re-downloads the ~400k-record NVD
                         feed on EVERY run; the file DB under ~/.dependency-check
                         is cached in CI (actions/cache) so only the delta is
                         fetched. -->
                    <dataDirectory>${user.home}/.dependency-check</dataDirectory>
                    <suppressionFiles>dependency-check-suppressions.xml</suppressionFiles>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
