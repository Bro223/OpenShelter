@startuml
title OpenShelter Frontend - App Architecture (Angular 22, standalone, zoneless)

' ============================================================
' STRUCTURE RULES (mirror of the backend pack, 01-TASK.md)
' 1. Layering: components (views) -> gateways (API access) ->
'    ApiClient (HTTP + error mapping). Never call HttpClient
'    outside the ApiClient.
' 2. Components are thin shells (backend rule §7): parse events,
'    delegate to services, bind signals. Zero business logic.
' 3. One gateway per backend resource group, mirroring the
'    backend controllers 1:1 (auth, shelter, review, verify,
'    account, geo) + ONE documented exception: GeocodeGateway
'    talks to an EXTERNAL service (OSM Nominatim) client-side
'    via raw fetch (no JWT, no backend hop, never ApiClient).
'    Field-for-field typed models (02-CONTEXT-API.md).
' 4. State: signals (Angular 22, zoneless - no zone.js in the
'    scaffold). AuthStore owns session state; feature pages own
'    local UI state; no NgRx in v1.
' 5. Program to an interface: gateways return typed models and
'    throw ApiError; pages depend on gateways, never on the
'    transport. Swapping HTTP for a fake (tests) is a one-line
'    provider change.
' 6. Secrets discipline: tokens are NOT placed in environment.ts.
'    Access token lives in memory; refresh token in localStorage
'    (XSS tradeoff documented) - httpOnly cookies deferred.
' ============================================================

package "core" {
  class ApiClient {
    - baseUrl : string
    + request<T>(method, path, body?) : Observable<T>
    + get<T>(path) : Observable<T>
    + post<T>(path, body) : Observable<T>
    + put<T>(path, body) : Observable<T>
    + delete(path) : Observable<void>
  }

  class ApiError {
    - timestamp : string
    - status : number
    - error : string
    - message : string
    - path : string
    + fromHttp(status, payload) : ApiError
    + fromNetwork() : ApiError   ' status 0 = backend unreachable
    + isNetworkError : boolean
  }

  class TokenStore {
    - accessToken : signal<string|null>
    ' localStorage
    - refreshToken : string|null
    + access(): string|null
    + setTokens(access, refresh, expiresIn)
    + clear()
  }

  class ThemeStore {
    - highContrast : signal<boolean>
    ' localStorage, key 'openshelter-theme' - only 'high-contrast' is ever
    ' stored, light = key absent (same persistence shape as TokenStore)
    + toggle()
    + set(highContrast : boolean)
    ' accessibility-and-provenance D2: sets/removes <html> data-theme
    ' (the [data-theme='high-contrast'] block in styles.scss is the seam);
    ' applied PRE-PAINT by the inline index.html script (no flash) - the
    ' constructor re-asserts it, an idempotent no-op on reload
  }

  class ApiInterceptor {
    + intercept(req, next)
    ' functional interceptor, registered in app.config.ts via
    ' provideHttpClient(withInterceptors([apiInterceptor])) (M1)
    ' attaches Bearer access token (never to /auth/login|refresh)
    ' on 401: single-flight AuthStore.refresh() + retry once
    ' on refresh failure: AuthStore cleared the session;
    '   Router -> /login?session=expired
  }

  class AuthGuard {
    ' functional guard (core/guards.ts), awaits AuthStore.init()
    ' so a reload restores the session before it decides
    ' anonymous -> /login?returnUrl=<current>
    + canActivate() : Promise<boolean | UrlTree>
  }

  class GuestGuard {
    ' functional guard (core/guards.ts), awaits AuthStore.init()
    ' already authenticated -> home (/map)
    + canActivate() : Promise<boolean | UrlTree>
  }

  class VerifiedGuard {
    ' functional guard (core/guards.ts), awaits AuthStore.init() (M5)
    ' no verification claim -> /verify?returnUrl=<current>
    ' used on /submit - mirrors the backend "verified account required" 403
    + canActivate() : Promise<boolean | UrlTree>
  }

  class AdminGuard {
    ' functional guard (core/guards.ts) - admin-moderation D2
    ' authenticated AND AuthStore.isAdmin()? else redirect HOME (/map)
    ' - anonymous AND authenticated non-admin alike go home (no /login
    ' offer - the admin tool has no guest value; the backend answers
    ' 401/403 the same way). Used on /admin; mirrors the backend's fresh
    ' kind lookup per request (UX, not enforcement). A failed profile
    ' fetch leaves isAdmin false - the guard fails closed.
    + canActivate() : Promise<boolean | UrlTree>
  }

  class TitleGuard {
    ' functional guard (core/title.ts) (M6) — every route carries data.title
    ' and sets document.title = "<Page> — OpenShelter" on activation
    + canActivate() : boolean | UrlTree
  }
}

package "session" {
  ' 2026-09-08 arch pass: auth-store MOVED OUT of core/ into its own
  ' session/ package - session state is its own concern, not transport.
  ' core/ keeps the guards + ApiInterceptor, which import
  ' "../session/auth-store" - that core→session edge is INTENTIONAL
  ' (core depends on session, never the reverse).
  class AuthStore {
    - authenticated : signal<boolean>
    - initialized : signal<boolean>
    ' M7 as-built: REAL profile from GET /account/me (fetched at boot after
    ' the silent refresh and after login); levels are the server's verified
    ' claims, never an optimistic mirror. A failed fetch is non-fatal: the
    ' session stays authenticated, the profile stays null (account page
    ' shows an error + retry), the next refresh recovers it.
    - name : signal<string|null>
    - email : signal<string|null>
    - phone : signal<string|null>
    - nationalIdCode : signal<string|null>
    - levels : signal<VerificationLevel[]>   ' REAL claims (EMAIL/PHONE)
    - isAdmin : signal<boolean>              ' admin-moderation: from GET
                                             ' /account/me (always present,
                                             ' false for every regular user);
                                             ' reset to false with the profile;
                                             ' fail-closed on a failed fetch.
                                             ' Drives the admin-only nav item
                                             ' + AdminGuard
    + init() : Promise<void>
    + register(request: RegisterRequest) : Promise<void>
    + login(emailOrPhone, password) : Promise<void>
    + logout() : Promise<void>
    ' single-flight: concurrent 401s share one refresh
    + refresh(): Promise<boolean>
    ' single-flight, non-fatal; re-fetches the profile after every
    ' claims-changing event (verify-confirm, contact change, profile edit)
    + refreshProfile() : Promise<void>
    + isVerified(): boolean         ' levels has EMAIL or PHONE (backend: any
                                    ' single level grants SUBMIT_SHELTER)
  }
}

package "gateways" {
  class AuthGateway {
    + register(request: RegisterRequest) : void
    + login(emailOrPhone, password) : TokenResponse
    + refresh(refreshToken) : TokenResponse
    + logout(refreshToken) : void
    + requestPasswordReset(email) : void
    + resetPassword(email, code, newPassword) : void
  }

  class VerifyGateway {
    + request(level: VerificationLevel) : void
    + confirm(level, code) : void
  }

  class ShelterGateway {
    + list(source: ShelterSourceFilter) : ShelterDto[]
    + get(id: number) : ShelterDto
    + create(request: CreateShelterRequest) : ShelterDto
    + mine() : ShelterDto[]                       ' M8: GET /api/shelters/mine
    + update(id, request: UpdateShelterRequest) : ShelterDto   ' M8: PUT
    + remove(id) : void                            ' M8: DELETE (gateway method is remove)
  }

  class ReviewGateway {
    + list(shelterId: number) : ShelterReviewDto[]
    + add(shelterId, rating, comment) : ShelterReviewDto
    + updateMine(shelterId, rating, comment) : ShelterReviewDto
    + deleteMine(shelterId) : void
  }

  class AccountGateway {
    + me() : MeResponse             ' GET /account/me - real profile + claims + isAdmin
    + updateProfile(request: ProfileUpdateRequest) : MeResponse
                                    ' PUT /account/profile (password-confirmed)
    + requestEmailChange(newEmail) : void
    + confirmEmailChange(code) : void
    + requestPhoneChange(newPhone) : void
    + confirmPhoneChange(code) : void
    + myReviews() : MyReviewDto[]    ' M8: GET /account/reviews/mine
  }

  class AdminGateway {
    ' admin-moderation - the door to the /admin/* controller group (one
    ' method per endpoint; typed promises; throws ApiError on failure).
    ' The backend re-checks the admin kind per request (401 anonymous,
    ' 403 non-admin, 409 registry-row writes).
    + listShelters(filters?: AdminShelterFilters) : AdminShelterDto[]
    ' GET /admin/shelters?status=&source=&q= - ALL rows incl. hidden;
    ' absent filter fields are omitted from the query string entirely
    + setShelterStatus(id: number, status: ShelterStatus) : void
    ' POST /admin/shelters/{id}/status {status} -> 204 - manual hide/restore
    ' (USER rows only; a restore disarms auto-hide server-side)
    + deleteShelter(id: number) : void
    ' DELETE /admin/shelters/{id} -> 204 - hard delete; reviews, reports
    ' and occupancy cascade (backend); USER rows only (409), 404 unknown
    + listShelterReports(shelterId?: number) : AdminShelterReportDto[]
    ' GET /admin/reports?shelterId= - the queue, newest first, with the
    ' shelter's LIVE status + the reporter's name/email
    + dismissShelterReport(id: number) : void
    ' POST /admin/reports/{id}/dismiss -> 204 - idempotent (no-op if done)
    + listReviewReports() : AdminReviewReportDto[]
    ' GET /admin/review-reports - newest first, hidden reviews included
    + hideReview(reviewId: number) : void
    ' POST /admin/reviews/{id}/hide -> 204, idempotent - {id} = the REVIEW id
    + restoreReview(reviewId: number) : void
    ' POST /admin/reviews/{id}/restore -> 204, idempotent - clears the hidden
    ' marker; the review rejoins the public list, average and count
  }

  class GeoGateway {
    + resolve(url: string) : LocationResolved
  }

  note bottom of GeoGateway
    POST /api/geo/resolve (JWT, per-IP 5/min) - maps.app.goo.gl short
    links only; the ONLY network call the /submit short-link mode makes
    (long-form URLs never hit the backend - parsed client-side).
  end note

  class GeocodeGateway {
    + search(query: string) : GeocodeResult[]
  }

  note bottom of GeocodeGateway
    DOCUMENTED EXCEPTION - client-side OSM Nominatim via RAW fetch()
    (external service: no JWT, no backend hop, never through ApiClient).
    The only module that knows the Nominatim URL (jsonv2, limit 5,
    countrycodes=ee - Estonia-restricted); hard 1000 ms request spacing
    (1 req/s usage policy); attribution always rendered by the caller.
  end note
}

package "features" {
  package "auth" {
    class LoginPage
    class RegisterPage
    class ResetPage
  }

  package "account" {
    class VerifyPage
    class AccountPage
    ' M8 "My contributions" panel. 2026-09-08 arch pass: MOVED here from
    ' features/contributions/ (that folder was deleted - zero
    ' cross-feature imports; account-page was its only importer).
    class ContributionsPanel
  }

  package "map" {
    class MapPage
    ' thin wrapper around leaflet lives in shared/ now (see below)
  }

  package "shelter" {
    class ShelterDetailPage
    class SubmitShelterPage
    class ReviewForm
    ' RatingStars moved to shared/ (2026-09-08 arch pass)
  }

  package "admin" {
    ' admin-moderation - own folder (the no-cross-feature-imports rule holds)
    class AdminPage
    ' /admin (lazy, AdminGuard) - three tabs, each a table with 48px action
    ' targets on the existing tokens: Shelters (search + inline Hide/Activate,
    ' two-tap Delete; registry rows read-only), Shelter reports (queue +
    ' dismiss, dismissed rows dimmed, "Restore shelter" shortcut on hidden-
    ' shelter rows), Review reports (queue + Hide/Restore + hidden badge).
    ' Mutations patch the in-memory row (204, no body); a rejected mutation
    ' surfaces the server message via the page-level banner.
  }
}

package "shared" {
  ' error / verify-prompt banners
  class BannerComponent
  ' REAL component (role=status, tokens only) - adopted in 4 template sites
  class LoadingIndicator
  ' header/nav + router-outlet
  class PageShell
  ' 2026-09-08 arch pass: shared/ now also hosts cross-feature UI + helpers
  ' RatingStars moved here from features/shelter/ (3 importers)
  class RatingStars
  ' LeafletService moved here from features/map/ (no feature deps)
  class LeafletService
  ' + non-component helpers: form-helpers.ts (readCoordinate,
  '   capacityValidator, nameBlankValidator, CAPACITY_MIN/MAX,
  '   CODE_SIX_DIGITS), shelter-copy.ts (canonical "User-submitted" / "★ x.x · N" copy),
  '   location-input.ts (pure parseLocationInput + isGooShortLink /
  '   normalizeShortLinkUrl - fixture-table-tested, no Angular imports)
}

note bottom of shared
  Non-component helpers: form-helpers.ts (readCoordinate, capacity /
  name validators, CODE_SIX_DIGITS), shelter-copy.ts (canonical
  "User-submitted" / rating copy + provenanceLabel - the single-sourced
  four-valued provenance badge: "Paasteamet registry" / "Municipal
  registry" / "Verified user" / "User-submitted") and location-input.ts
  (pure parseLocationInput + isGooShortLink / normalizeShortLinkUrl -
  fixture-table-tested, zero Angular imports).
end note

' --- wiring ---------------------------------------------------
PageShell --> RouterOutlet
AuthGateway ..> ApiClient
VerifyGateway ..> ApiClient
ShelterGateway ..> ApiClient
ReviewGateway ..> ApiClient
AccountGateway ..> ApiClient
GeoGateway ..> ApiClient
' GeocodeGateway has NO ApiClient edge - it is the documented raw-fetch
' exception (external Nominatim, client-side).
AuthStore ..> AuthGateway
AuthStore ..> AccountGateway
AuthStore ..> TokenStore
ApiInterceptor ..> TokenStore
ApiInterceptor ..> AuthStore
ApiInterceptor ..> Router
AuthGuard ..> AuthStore
GuestGuard ..> AuthStore
VerifiedGuard ..> AuthStore
AdminGuard ..> AuthStore
TitleGuard ..> Title

note top of ApiClient
  Typed models live in core/models.ts - field-for-field mirror of the
  backend DTOs (02-CONTEXT-API.md). One caveat fixed against the real
  backend: ShelterDto.address is string|null (USER rows store no
  address) even though the md types it string.
end note

LoginPage --> AuthStore
RegisterPage --> AuthStore
ResetPage --> AuthGateway
LoginPage --> BannerComponent
RegisterPage --> BannerComponent
ResetPage --> BannerComponent
VerifyPage --> VerifyGateway
AccountPage --> AccountGateway
' M3 wiring: both account pages read AuthStore (levels / profile / verify CTA)
VerifyPage --> AuthStore
AccountPage --> AuthStore
VerifyPage --> BannerComponent
AccountPage --> BannerComponent
AccountPage --> ContributionsPanel
ContributionsPanel --> ShelterGateway
ContributionsPanel --> AccountGateway
ContributionsPanel --> ReviewGateway
ContributionsPanel --> BannerComponent
MapPage --> ShelterGateway
MapPage --> LeafletService
AdminPage --> AdminGateway
AdminPage --> AuthStore
AdminPage --> BannerComponent
ShelterDetailPage --> ShelterGateway
ShelterDetailPage --> ReviewGateway
ShelterDetailPage --> AuthStore
ShelterDetailPage --> LeafletService
ShelterDetailPage --> ReviewForm
ShelterDetailPage --> RatingStars
ShelterDetailPage --> BannerComponent
SubmitShelterPage --> ShelterGateway
SubmitShelterPage --> GeoGateway
SubmitShelterPage --> GeocodeGateway
SubmitShelterPage --> LeafletService
SubmitShelterPage --> BannerComponent
ReviewForm --> RatingStars
PageShell --> AuthStore
' high-contrast toggle lives in the shell header (bound to ThemeStore)
PageShell --> ThemeStore
PageShell --> Router

note bottom of PageShell
  M3: the shell adds authenticated nav links - "Account" (/account).
  M7: the standalone "Verify" link is REMOVED from the nav; /verify stays
  reachable by route (guard redirects + the account page's per-contact
  "Complete verification" CTAs).
  admin-moderation D5: the nav gains a SINGLE "Admin" item, rendered only
  when AuthStore.isAdmin() is true (from GET /account/me - always present,
  false for every regular user) - regular users see the nav unchanged; a
  failed profile fetch leaves isAdmin false, so the item hides itself
  fail-closed.
end note

note bottom of MapPage
  M4: real Leaflet map + source filter + sidebar
  (04-map-browse-flow.puml). Marker/list-row clicks
  select + zoom to street level (SHELTER_ZOOM 16) and
  stay on /map; the selected row's "View details" link
  opens /shelters/:id - the M5 detail page (which
  itself shows a static Location map).
end note

note top of LeafletService
  leaflet is used directly (npm "leaflet") behind this thin
  service - ngx-leaflet style wrappers lag Angular majors and
  are NOT used. MapLibre GL is a documented future swap.
end note

' --- routes (M0-M6 build-up; every route also runs TitleGuard (M6)) -------
note as Routes
  '/ -> redirect'        public       -> MapPage      (M2 stub; real map M4)
  /map               public       -> MapPage        (M2 stub page; Leaflet map in M4)
  /login             GuestGuard   -> LoginPage      (M2)
  /register          GuestGuard   -> RegisterPage   (M2)
  /reset             GuestGuard   -> ResetPage      (M2)
  /verify            AuthGuard    -> VerifyPage        (M3 DONE)
  /account           AuthGuard    -> AccountPage       (M3 page; M7 full profile)
  /shelters/:id      public       -> ShelterDetailPage(M5, lazy M6)
  /submit            AuthGuard + VerifiedGuard -> SubmitShelterPage (M5, lazy M6)
  /admin             AdminGuard     -> AdminPage          (admin-moderation, lazy)
  ' M6: all routes data.title + TitleGuard; /shelters/:id and /submit
  '     loadComponent-lazy for the documented bundle budget (so is /admin)
end note
@enduml
