@startuml
title Auth Flow - Register, Login, Silent Refresh, 401 Handling, Reset (M1-M2)

actor Person

participant "LoginPage / RegisterPage" as PG
participant "AuthStore" as AS
participant "AuthGateway" as AG
participant "ApiClient" as AC
participant "ApiInterceptor" as AI
participant "TokenStore" as TS
participant "AuthGuard" as G
database "Spring Boot /auth" as API

== Register ==
Person -> PG : name, email, phone, password
PG -> AS : register(...)
AS -> AG : register(request)
AG -> AC : post<void>('/auth/register', body)
AC -> API : POST /auth/register
API --> AC : 201 Created
note over AC
  backend stores Argon2id hash; email/phone normalized
  (E.164 + lowercase). Duplicates -> 409.
end note
AC --> AS : ok
AS --> PG : success view -> /login -> verify (M3: "Verify" link in the shell)
note over PG
  backend response is empty on register; no session yet -
  user must log in once (M2 flow below). The 409 path
  surfaces ApiError.message from the uniform ErrorResponse.
end note

== Login ==
Person -> PG : emailOrPhone, password
PG -> AS : login(emailOrPhone, password)
AS -> AG : login(...)
AG -> AC : post<TokenResponse>('/auth/login', body)
AC -> API : POST /auth/login
alt 401
  API --> AC : ErrorResponse 401 "invalid credentials"
  AC --> AS : ApiError thrown
  AS --> PG : generic error banner (no enumeration)
else 200
  API --> AC : TokenResponse { accessToken, refreshToken, expiresIn }
  AC --> AS : tokens
  AS -> TS : setTokens(access, refresh, expiresIn)
  note over TS
    access token: in-memory signal only.
    refresh token: localStorage (survives reload).
    v1 XSS tradeoff documented; httpOnly-cookie migration is a
    deferred backend change.
  end note
  AS --> PG : redirect to /map (or returnUrl)
end

== App boot: silent refresh ==
note over AS
  AuthStore.init() runs once at bootstrap.
end note
AS -> TS : read refresh token
alt no refresh token
  AS --> : anonymous - route guards allow public pages only
else refresh token exists
  AS -> AG : refresh(refreshToken)
  AG -> AC : post<TokenResponse>('/auth/refresh', body)
  AC -> API : POST /auth/refresh
  alt 200 -> rotated pair
    API --> AS : new access + refresh
    AS -> TS : setTokens(...)
  else 401 (expired/revoked)
    API --> AS : 401
    AS -> TS : clear()
    AS --> G : route to /login
  end
end

== Any API call: 401 mid-session ==
note over AI
  ApiInterceptor attaches "Authorization: Bearer <access>"
  to every request that carries a token (never to /auth/login
  or /auth/refresh).
end note
PG -> AC : fetch protected resource
AC -> API : GET /protected (stale access token)
API --> AC : 401
AC --> AI : intercepted
AI -> AS : refresh()   ' single-flight: concurrent 401s share one refresh
alt refresh succeeds
  AI -> AC : retry original request once (new Bearer)
  AC --> PG : data
else refresh fails (401)
  note over AS
    AuthStore.refresh() returns false and clears the session
    (tokens.clear + authenticated=false) inside the refresh call.
  end note
  AS -> TS : clear()
  AI --> : Router redirect /login?session=expired
end

== Logout ==
Person -> PG : logout
PG -> AS : logout()
AS -> AG : logout(refreshToken)
AG -> AC : post<void>('/auth/logout', body)
AC -> API : POST /auth/logout  -> 204
AS -> TS : clear()  ' local state cleared regardless of network
note over AS
  AuthStore also resets the profile (incl. verified claims) on logout /
  cleared session - claims persist server-side and are re-fetched at boot
  via GET /account/me.
end note
AS --> PG : redirect /map

== Password reset (emailed 6-digit code - no link) ==
participant "ResetPage" as RP
Person -> RP : e-mail
RP -> AG : requestPasswordReset(email)
AG -> AC : post<CodeSentDto>('/auth/password-reset/request', body)
AC -> API : POST /auth/password-reset/request
API --> AC : 200 (always - anti-enumeration)
AC --> RP : ok
note over RP
  Same anti-enumeration copy for known and unknown
  e-mails: "If an account exists for that email, a
  6-digit code has been sent to it."
end note
note over API
  The e-mail carries the 6-digit code (15-min TTL,
  stored SHA-256-hashed, one active code per user,
  5-attempt limit) - no URL link.
end note
Person -> RP : code + new password + repeat
RP -> AG : resetPassword(email, code, newPassword)
AG -> AC : post<void>('/auth/password-reset/confirm', body)
AC -> API : POST /auth/password-reset/confirm
alt 400 (wrong / expired / used / over-limit - one generic message)
  API --> AC : ErrorResponse 400
  AC --> RP : generic inline banner (form stays usable)
else 200
  note over API
    Password changed, code marked used, ALL refresh
    tokens revoked (every other session dies).
  end note
  API --> RP : ok
  RP --> Person : redirect /login?reset=ok
end
@enduml
