# Shelter Map — environment TEMPLATE (tracked; placeholders only, no real values).
#
# Copy it and fill in your own values:
#     cp .env.example .env
#
# Spring loads `.env` automatically at startup via spring-dotenv
# (me.paulschwarz:spring-dotenv); shell-exported variables take precedence.
# `.env` is gitignored — never commit it, and never put a real credential,
# host or token into THIS file.
#
# Any variable left unset falls back to the default in
# src/main/resources/application.yml. The SECRET-bearing variables are
# commented out on purpose: set them in `.env` with a generated value rather
# than an empty one — a blank JWT_SECRET or blank PII keys are worse than the
# default (an unusable signing key, or a boot that refuses to start).
# Generate one with:  openssl rand -base64 32

# ---- Database (spring.datasource.*) ----
# Unset, these fall back to the dev defaults in src/main/resources/application.yml — the
# docker-compose.yml database on localhost:5432 (database/user/password `sheltermap`,
# published dev-only values). Set real ones for any deployment: a non-dev/test profile
# that still carries the published password refuses to start
# (src/main/java/ee/sheltermap/config/DataSourceCredentialGuard.java).
# DB_URL=jdbc:postgresql://localhost:5432/sheltermap
# DB_USERNAME=
# DB_PASSWORD=

# ---- JWT signing (app.jwt.secret) ----
# Any non-dev/test profile refuses the published dev default and anything shorter
# than 32 bytes.
# JWT_SECRET=

# ---- Admin seeding (app.admin.*) ----
# Both set + no account with that e-mail → an ADMIN account is created at startup
# (create-if-absent). Either unset → no admin exists and /admin/* answers 403.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- PII at rest (app.pii.*) — REQUIRED in every profile: a blank key refuses the boot ----
# 32-byte base64 AES-GCM data key, and 32-byte base64 HMAC blind-index key.
# PII_AES_KEY=
# PII_HMAC_KEY=

# ---- E-mail delivery (app.mail.provider) ----
# `dev` logs every code to the console and is refused on a non-dev/test profile;
# set your real provider's name for actual delivery.
MAIL_PROVIDER=dev
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# ---- SMS delivery (app.sms.provider) ----
# `dev` logs every code to the console and is refused on a non-dev/test profile.
SMS_PROVIDER=dev
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM=

# ---- Dev-only diagnostic endpoints (each is refused outside dev/test) ----
# POST /dev/email-test and POST /dev/sms-test (JWT + recipient allowlist).
DEV_EMAIL_TEST_ENABLED=false
# DEV_EMAIL_TEST_ALLOWED_RECIPIENTS=
DEV_SMS_TEST_ENABLED=false
# DEV_SMS_TEST_ALLOWED_RECIPIENTS=

# ---- Rate limiting behind a reverse proxy ----
# Comma-separated CIDRs whose X-Forwarded-For the rate limiter honors
# (empty = trust none — the rate limit then applies to the PROXY's IP, not
# the clients). Set it when deploying behind a reverse proxy.
# RATELIMIT_TRUSTED_PROXIES=
# The springdoc /v3/api-docs + /swagger-ui surface (refused outside dev/test).
SPRINGDOC_ENABLED=false
