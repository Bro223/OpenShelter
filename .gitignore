# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ---- Maven / Java build output ----
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Secrets / local config ----
.env
.env.*
*.local.yml
*.local.properties
# Private keys / credentials that must never be committed
*.pem
*.key
*.p12
*.jks
*.keystore
*.cer
*.crt
*.pub
# SMTP / SMS / API credentials files (real providers — never commit)
*credentials*.json
*smtp*.env
# Local toolchain archives
maven.tar.gz
apache-maven-*.tar.gz

# ---- Tool caches ----
.ruff_cache/
.pytest_cache/
__pycache__/

# ---- Runtime data ----
# Pi agent runtime state (watchdog schedules, subagent scratch) — never repo content
.pi/
# File-backed verification send log (anti-spam daily cap) — survives restarts,
# but must never be committed (contains contacts/timestamps).
data/
# Crisis-guidance media uploads: the default dir already sits under the data/
# rule above — the explicit entry pins that, so a future change to the ignore
# structure cannot silently start committing uploads.
data/media/

# JVM attach artifacts (JDK tools; never repo content)
.attach_pid*

# ---- Repo-root tooling artifacts (never repo content) ----
# Root-level node toolchain + vitest cache (frontend/node_modules is covered
# by frontend/.gitignore; these top-level dirs are NOT and must stay untracked)
/node_modules/
/vitest_node_modules/
/test_node_modules/
.vitest/

# Angular build cache (generated at the repo root when a build is run from here)
/.angular/

# The template is documentation the env-completeness guard verifies; only real secrets are ignored.
!.env.example
